aamp: record DASH fragment position jumps in avlog

Record the track and three timing values in microseconds. Audio and video jumps request a timed capture.

diff --git a/AampAvlog.h b/AampAvlog.h
new file mode 100644
index 0000000..f716c79
--- /dev/null
+++ b/AampAvlog.h
@@ -0,0 +1,69 @@
+/*
+ * AampAvlog.h - write AAMP position-jump records to avlog.ko.
+ * Keep the wire layout in sync with the vendor avlog UAPI.
+ */
+#ifndef AAMP_AVLOG_H
+#define AAMP_AVLOG_H
+
+#include <stdint.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <atomic>
+#include <cmath>
+
+#define AVLOG_PAYLOAD_SIZE     52
+#define AVLOG_USER             6
+#define AVLOG_MEDIA_VIDEO      1
+#define AVLOG_MEDIA_AUDIO      2
+#define AVLOG_MEDIA_SUB        3
+#define AVLOG_USER_AAMP_JUMP   1
+#define AVLOG_UF_ARM_TIMER     (1u << 0)
+#define AVLOG_UF_TRIGGER       (1u << 1)   /* set by the kernel */
+
+struct avlog_aamp_jump {
+    uint32_t type;
+    uint32_t user;
+    uint32_t media;
+    uint32_t flags;
+    uint32_t position_delta_lo;
+    uint32_t position_delta_hi;
+    uint32_t last_injected_lo;
+    uint32_t last_injected_hi;
+    uint32_t abs_position_lo;
+    uint32_t abs_position_hi;
+    uint32_t seq;
+    uint32_t reserved[2];
+};
+static_assert(sizeof(avlog_aamp_jump) == AVLOG_PAYLOAD_SIZE, "avlog payload must be 52 bytes");
+
+static inline void AampAvlogPut64(uint32_t &lo, uint32_t &hi, int64_t value)
+{
+    const uint64_t bits = static_cast<uint64_t>(value);
+    lo = static_cast<uint32_t>(bits);
+    hi = static_cast<uint32_t>(bits >> 32);
+}
+
+static inline void AampAvlogPositionJump(int trackType, double positionDelta,
+                                        double lastInjectedDuration, double absPosition)
+{
+    static int fd = open("/proc/avlog/data", O_WRONLY | O_CLOEXEC);
+    static std::atomic<uint32_t> seq{0};
+    if (fd < 0)
+        return;
+
+    avlog_aamp_jump j = {};
+    j.type = AVLOG_USER;
+    j.user = AVLOG_USER_AAMP_JUMP;
+    j.media = trackType == 0 ? AVLOG_MEDIA_VIDEO :
+              trackType == 1 ? AVLOG_MEDIA_AUDIO :
+              trackType == 2 ? AVLOG_MEDIA_SUB : 0;
+    if (j.media == AVLOG_MEDIA_VIDEO || j.media == AVLOG_MEDIA_AUDIO)
+        j.flags |= AVLOG_UF_ARM_TIMER;
+    AampAvlogPut64(j.position_delta_lo, j.position_delta_hi, std::llround(positionDelta * 1e6));
+    AampAvlogPut64(j.last_injected_lo, j.last_injected_hi, std::llround(lastInjectedDuration * 1e6));
+    AampAvlogPut64(j.abs_position_lo, j.abs_position_hi, std::llround(absPosition * 1e6));
+    j.seq = ++seq;
+    (void)!write(fd, &j, sizeof(j));
+}
+
+#endif /* AAMP_AVLOG_H */
