From b0c4c33975c29d04f9962e1d5f2c7de5f4fedbdf Mon Sep 17 00:00:00 2001
From: Eugene Mutavchi <Ievgen_Mutavchi@comcast.com>
Date: Wed, 9 Sep 2026 18:33:18 +0000
Subject: [PATCH 4/6] Disable rewriting of paths returned by pkg-config

---
 build/config/linux/pkg-config.py  | 1 +
 build/config/linux/pkg_config.gni | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/build/config/linux/pkg-config.py b/build/config/linux/pkg-config.py
index f4d31de6769..85fa99a5a86 100755
--- a/build/config/linux/pkg-config.py
+++ b/build/config/linux/pkg-config.py
@@ -95,6 +95,7 @@ def MatchesAnyRegexp(flag, list_of_regexps):
 
 def RewritePath(path, strip_prefix, sysroot):
   """Rewrites a path by stripping the prefix and prepending the sysroot."""
+  return path
   if os.path.isabs(path) and not path.startswith(sysroot):
     if path.startswith(strip_prefix):
       path = path[len(strip_prefix):]
diff --git a/build/config/linux/pkg_config.gni b/build/config/linux/pkg_config.gni
index 8b7333f6044..4ba06c0d16d 100644
--- a/build/config/linux/pkg_config.gni
+++ b/build/config/linux/pkg_config.gni
@@ -178,7 +178,7 @@ template("pkg_config") {
     cflags = pkgresult[1]
 
     foreach(_path, pkgresult[0]) {
-      supports_isystem = true
+      supports_isystem = false
       if (defined(invoker.supports_isystem)) {
         supports_isystem = invoker.supports_isystem
       }
-- 
2.34.1

