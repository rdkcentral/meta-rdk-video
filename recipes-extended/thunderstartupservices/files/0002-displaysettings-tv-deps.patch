index 182a4b1..635ea6c 100644
--- a/wpeframework-audiooutput.service
+++ b/wpeframework-audiooutput.service
@@ -1,7 +1,7 @@
 [Unit]
 Description=WPEFramework AudioOutput Initialiser
-Requires=wpeframework.service wpeframework-displaysettings.service wpeframework-devicesettings.service
-After=wpeframework.service wpeframework-displaysettings.service wpeframework-devicesettings.service
