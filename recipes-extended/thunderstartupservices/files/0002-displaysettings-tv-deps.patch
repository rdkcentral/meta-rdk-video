diff -uprN a/wpeframework-displaysettings.service b/wpeframework-displaysettings.service
--- a/wpeframework-displaysettings.service	2024-07-09 23:22:54.827863978 +0300
+++ b/wpeframework-displaysettings.service	2024-07-10 19:27:36.708407535 +0300
@@ -1,7 +1,7 @@
 [Unit]
 Description=WPEFramework DisplaySettings Initialiser
-Requires=wpeframework-powermanager.service wpeframework-devicesettings.service
-After=wpeframework-powermanager.service wpeframework-devicesettings.service
+Requires=pqserver.service wpeframework-hdmicecsink.service wpeframework-powermanager.service wpeframework-devicesettings.service
