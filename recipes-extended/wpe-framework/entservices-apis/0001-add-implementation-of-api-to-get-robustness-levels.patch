From 801adc98690ac9b1222861b4db0fe9163a06e09a Mon Sep 17 00:00:00 2001
From: Krishna Priya Kanagaraj <krishnapriya_kanagaraj@comcast.com>
Date: Tue, 12 May 2026 06:59:55 +0000
Subject: [PATCH] add implementation of api to get robustness levels

---
 apis/Ids.h            | 1 +
 apis/OpenCDMi/IDRM.h  | 6 ++++++
 apis/OpenCDMi/IOCDM.h | 9 +++++++++
 3 files changed, 16 insertions(+)

diff --git a/apis/Ids.h b/apis/Ids.h
index eadd0b8..e59fbc1 100755
--- a/apis/Ids.h
+++ b/apis/Ids.h
@@ -128,6 +128,7 @@ namespace Exchange {
         ID_SESSION                                   = ID_ACCESSOROCDM + 1,
         ID_SESSION_CALLBACK                          = ID_ACCESSOROCDM + 2,
         ID_SESSION_EXTENSION                         = ID_ACCESSOROCDM + 3,
+        ID_WIDEVINE_ROBUSTNESS_EXTENSION             = ID_ACCESSOROCDM + 4,
 
         ID_MESSAGE_CONTROL                           = ID_ENTOS_OFFSET + 0x100,
         ID_MESSAGE_CONTROL_ITERATOR                  = ID_MESSAGE_CONTROL + 1,
diff --git a/apis/OpenCDMi/IDRM.h b/apis/OpenCDMi/IDRM.h
index f8b8a7d..4595cc4 100644
--- a/apis/OpenCDMi/IDRM.h
+++ b/apis/OpenCDMi/IDRM.h
@@ -43,6 +43,7 @@
 // For the support of portable data types such as uint8_t.
 #include <stdint.h>
 #include <string>
+#include <list>
 #include <type_traits>
 #include <typeinfo>
 #include <vector>
@@ -521,6 +522,11 @@ struct IGoogleCastAuthExtension {
     virtual CDMi_RESULT GetSystemId(uint32_t& id /* @out */) const = 0;
 };
 
+struct IWidevineRobustnessExtension {
+    virtual ~IWidevineRobustnessExtension() = default;
+    virtual CDMi_RESULT GetSupportedRobustness(std::list<std::string>& levels) const = 0;
+};
+
 struct ISystemFactory {
     virtual ~ISystemFactory() = default;
     virtual IMediaKeys* Instance() = 0;
diff --git a/apis/OpenCDMi/IOCDM.h b/apis/OpenCDMi/IOCDM.h
index 27cb4c1..c535924 100644
--- a/apis/OpenCDMi/IOCDM.h
+++ b/apis/OpenCDMi/IOCDM.h
@@ -411,6 +411,15 @@ struct EXTERNAL IGoogleCastAuthExtension : virtual public Core::IUnknown {
     virtual OCDM_RESULT GetSystemId(uint32_t& id /* @out */) const = 0;
 };
 
+struct EXTERNAL IWidevineRobustnessExtension : virtual public Core::IUnknown {
+    enum { ID = ID_WIDEVINE_ROBUSTNESS_EXTENSION };
+
+    virtual ~IWidevineRobustnessExtension() override = default;
+
+    // Get the Robustness level from Widevine DRM
+    virtual OCDM_RESULT GetSupportedRobustness(RPC::IStringIterator*& robustness /* @out */) const = 0;
+};
+
 } //namespace Exchange
 } //namespace WPEFramework
 
-- 
2.44.4

