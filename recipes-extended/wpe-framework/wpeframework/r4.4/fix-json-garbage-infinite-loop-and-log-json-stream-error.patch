diff --git a/Tests/streamjson-garbage/GarbageTest.cpp b/Tests/streamjson-garbage/GarbageTest.cpp
new file mode 100644
index 00000000..f6717a5f
--- /dev/null
+++ b/Tests/streamjson-garbage/GarbageTest.cpp
@@ -0,0 +1,295 @@
+/*
