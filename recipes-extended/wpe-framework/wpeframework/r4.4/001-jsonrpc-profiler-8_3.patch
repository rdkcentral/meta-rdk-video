diff --git a/Source/core/Profiler.cpp b/Source/core/Profiler.cpp
index e69de29bb..092548975 100644
--- a/Source/core/Profiler.cpp
+++ b/Source/core/Profiler.cpp
@@ -0,0 +1,119 @@
+#include "Profiler.h"
+
+namespace WPEFramework {
+
+namespace Core {
+
+    /* static */ JsonRpcProfiler& JsonRpcProfiler::Instance()
+    {
+        static JsonRpcProfiler& instance = SingletonType<JsonRpcProfiler>::Instance();
+        return (instance);
+    }
+
+    JsonRpcProfiler::JsonRpcProfiler()
+    {
+        std::ifstream logFile(_fileName);
+        bool fileExists = logFile.good();
+        logFile.close();
+
+        _logFile.open(_fileName, std::ios::app);
+
+        if(!fileExists)
+        {
+            std::cout << "JsonRpcProfiler [INFO]: Writing to file " << _fileName << std::endl;
+
+            _logFile << "PluginApi" << ", RequestType" << ", QueueLength" << ", RequestTimeStamp" 
+                    << ", InvokeTimeStamp"  << ", ThunderLatency(ms)" << ", ResponseTimeStamp" 
+                    << ", PluginLatency(ms)" << ", TotalLatency(ms)" << std::endl;
+        }
+        std::cout << "JsonRpcProfiler [INFO]: Init done !!" << std::endl;
+    }
+    
+    JsonRpcProfiler::~JsonRpcProfiler() 
+    {
+        _logFile.close();
+        std::cout << "JsonRpcProfiler [INFO]: DeInit done !!" << std::endl;
+    }
+
+    std::string JsonRpcProfiler::timeStamp(const timePoint& tp)
+    {
+        std::time_t tt = std::chrono::system_clock::to_time_t(tp);
+        std::tm tm;
+        gmtime_r(&tt, &tm);
+        auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(tp.time_since_epoch()) % 1000;
+        char buffer[40];
+        std::snprintf(buffer, sizeof(buffer),
+            "%04d-%02d-%02dT%02d:%02d:%02d.%03ldZ",
+            tm.tm_year + 1900,
+            tm.tm_mon + 1,
+            tm.tm_mday,
+            tm.tm_hour,
+            tm.tm_min,
+            tm.tm_sec,
+            static_cast<long>(ms.count()));
+        return std::string(buffer);
+    }
+
+    std::chrono::milliseconds::rep JsonRpcProfiler::elapsedTime(const timePoint& tp1, const timePoint& tp2)
+    {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(tp1 - tp2).count();
+    }
+
+    void JsonRpcProfiler::log(uint32_t channelId)
+    {
+        _logFile << _map[channelId].api << ", " << _map[channelId].type 
+                << ", " << _map[channelId].queueLength 
+                << ", " << timeStamp(_map[channelId].requestTime) 
+                << ", " << timeStamp(_map[channelId].invokeTime)
+                << ", " << elapsedTime(_map[channelId].invokeTime, _map[channelId].requestTime)
+                << ", " << timeStamp(_map[channelId].responseTime)
+                << ", " << elapsedTime(_map[channelId].responseTime, _map[channelId].invokeTime)
+                << ", " << elapsedTime(_map[channelId].responseTime, _map[channelId].requestTime) << std::endl;  
+    }
+
+    void JsonRpcProfiler::logRequest(uint32_t channelId, const std::string& api)
+    {
+        if(_map.find(channelId) == _map.end())
+        {
+            _map.emplace(channelId, Info());
+            _map[channelId].api = api;
+            _map[channelId].requestTime = std::chrono::system_clock::now();
+            _map[channelId].type = "JSON-RPC";
+        }
+        else
+            std::cout << "JsonRpcProfiler [ERROR][logRequest]: Duplicate Channel Id "  << channelId << " for " << api << std::endl;
+    }
+
+    void JsonRpcProfiler::logQueue(uint32_t channelId, uint32_t len)
+    {
+        if(_map.find(channelId) != _map.end())
+        {
+            _map[channelId].queueLength = len;
+        }
+        else
+            std::cout << "JsonRpcProfiler [ERROR][logQueue]: Channel Id "  << channelId << " not found !!" << std::endl;
+    }
+
+    void JsonRpcProfiler::logInvoke(uint32_t channelId)
+    {
+        if(_map.find(channelId) != _map.end())
+        {
+            _map[channelId].invokeTime = std::chrono::system_clock::now();
+        }
+        else
+            std::cout << "JsonRpcProfiler [ERROR][logQueue]: Channel Id "  << channelId << " not found !!" << std::endl;
+    }
+
+    void JsonRpcProfiler::logResponse(uint32_t channelId)
+    {
+        if(_map.find(channelId) != _map.end())
+        {
+            _map[channelId].responseTime = std::chrono::system_clock::now();
+            log(channelId);
+            _map.erase(channelId);
+        }
+        else
+            std::cout << "JsonRpcProfiler [ERROR][logResponse]: Channel Id "  << channelId << " not found !!" << std::endl;
+    }
+}
+} 
