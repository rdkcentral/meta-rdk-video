diff --git a/Source/core/Profiler.h b/Source/core/Profiler.h
index e69de29bb..fed722b92 100644
--- a/Source/core/Profiler.h
+++ b/Source/core/Profiler.h
@@ -0,0 +1,64 @@
+// bvanav-dbg
+#ifndef PROFILER_H
+#define PROFILER_H
+
+#include "Module.h"
+#include "Portability.h"
+#include "Singleton.h"
+#include <chrono>
+#include <ctime>
+#include <fstream>
+#include <iostream>
+#include <unordered_map>
+namespace WPEFramework {
+
+namespace Core {
+
+    class EXTERNAL JsonRpcProfiler {
+        typedef std::chrono::system_clock::time_point timePoint;
+
+        private:
+            JsonRpcProfiler();
+            JsonRpcProfiler(const JsonRpcProfiler&) = delete;
+            JsonRpcProfiler& operator=(const JsonRpcProfiler&) = delete;
+            friend class SingletonType<JsonRpcProfiler>;
+
+            struct Info
+            {
+                Info()
+                    : api(), queueLength(0), requestTime(), invokeTime(), responseTime()
+                {}
+
+                std::string api;
+                std::string type;
+                uint32_t queueLength;
+                timePoint requestTime;
+                timePoint invokeTime;
+                timePoint responseTime;
+            };
+
+            static constexpr const char* _fileName = "/opt/logs/thunder-api-latency.csv";
+
+            /* helpers */
+            std::chrono::milliseconds::rep elapsedTime(const timePoint& tp1, const timePoint& tp2);
+            string timeStamp(const timePoint& tp);
+            void log(uint32_t channelId);
+
+        public:
+            static JsonRpcProfiler& Instance();
+            ~JsonRpcProfiler();
+
+            void logRequest(uint32_t channelId, const string& api);
+            void logQueue(uint32_t channelId, uint32_t len);
+            void logInvoke(uint32_t channelId);
+            void logResponse(uint32_t channelId);
+
+        private: 
+            std::ofstream _logFile;
+            std::unordered_map<int, Info> _map;
+    };
+
+}
+} 
+
+#endif
