From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DS_COMRPC migration <ds_comrpc@migration>
Date: Sun, 20 Jul 2026 00:00:00 +0000
Subject: [PATCH] DS_COMRPC: disable libds calls in ctrlm-main

dsMgr daemon is disabled on XiOne-UK. The 5 ctrlm_dsmgr_* wrapper
functions in ctrlm_utils.cpp return no-op success values. Audio ducking
and FrontPanel LED control via libds are silently skipped.
---
--- a/src/ctrlm_utils.cpp
+++ b/src/ctrlm_utils.cpp
@@ -38,12 +38,14 @@
 #include "videoOutputPort.hpp"
 #include "videoOutputPortType.hpp"
 #include "videoOutputPortConfig.hpp"
+#ifndef DISABLE_DEVICESETTINGS
 #include "audioOutputPort.hpp"
 #include "frontPanelIndicator.hpp"
 #include "manager.hpp"
 #include "dsMgr.h"
 #include "dsRpc.h"
 #include "dsDisplay.h"
+#endif /* DISABLE_DEVICESETTINGS */
 #include <regex>
 // end dsMgr includes
 
@@ -1570,6 +1572,7 @@
 }
 
 bool ctrlm_dsmgr_init() {
+#ifndef DISABLE_DEVICESETTINGS
    if(device::Manager::IsInitialized) {
       XLOGD_INFO("DSMgr already initialized");
       return true;
@@ -1583,9 +1586,15 @@
       return false;
    }
    return true;
+#else
+   /* DS_COMRPC migration: dsMgr disabled - no-op */
+   XLOGD_INFO("ctrlm_dsmgr_init: dsMgr disabled (DS_COMRPC migration)");
+   return true;
+#endif
 }
 
 bool ctrlm_dsmgr_deinit() {
+#ifndef DISABLE_DEVICESETTINGS
    try {
       if(device::Manager::IsInitialized) {
          device::Manager::DeInitialize();
@@ -1596,9 +1605,14 @@
       return false;
    }
    return true;
+#else
+   /* DS_COMRPC migration: dsMgr disabled - no-op */
+   return true;
+#endif
 }
 
 bool ctrlm_dsmgr_mute_audio(bool mute) {
+#ifndef DISABLE_DEVICESETTINGS
   try {
      dsAudioDuckingAction_t action = mute ? dsAUDIO_DUCKINGACTION_START : dsAUDIO_DUCKINGACTION_STOP;
      device::Host::getInstance().getAudioOutputPort("SPEAKER0").setAudioDucking(action, dsAUDIO_DUCKINGTYPE_ABSOLUTE, mute ? 0 : 100);
@@ -1609,9 +1623,15 @@
     return false;
   }
   return true;
+#else
+  /* DS_COMRPC migration: dsMgr disabled - audio ducking is a no-op */
+  XLOGD_INFO("ctrlm_dsmgr_mute_audio: dsMgr disabled, skipping (%s)", mute?"mute":"unmute");
+  return true;
+#endif
 }
 
 bool ctrlm_dsmgr_duck_audio(bool enable, bool relative, double vol) {
+#ifndef DISABLE_DEVICESETTINGS
   if(vol < 0 || vol > 1) {
       XLOGD_ERROR("Invalid volume");
       return false;
@@ -1635,9 +1655,15 @@
     return false;
   }
   return true;
+#else
+  /* DS_COMRPC migration: dsMgr disabled - audio ducking is a no-op */
+  XLOGD_INFO("ctrlm_dsmgr_duck_audio: dsMgr disabled, skipping");
+  return true;
+#endif /* DISABLE_DEVICESETTINGS */
 }
 
 bool ctrlm_dsmgr_LED(bool on) {
+#ifndef DISABLE_DEVICESETTINGS
   try {
     device::FrontPanelIndicator &led =  device::FrontPanelIndicator::getInstance("Power");
     if (on) {
@@ -1651,6 +1677,11 @@
     return false;
   }
   return true;
+#else
+  /* DS_COMRPC migration: dsMgr disabled - FrontPanel LED is a no-op */
+  XLOGD_INFO("ctrlm_dsmgr_LED: dsMgr disabled, skipping (%s)", on?"on":"off");
+  return true;
+#endif /* DISABLE_DEVICESETTINGS */
 }
 
 bool ctrlm_is_voice_assistant(ctrlm_rcu_controller_type_t controller_type) {
--- a/src/ctrlm_main.cpp
+++ b/src/ctrlm_main.cpp
@@ -74,9 +74,11 @@
 #include "rf4ce/ctrlm_rf4ce_network.h"
 #include "ctrlm_device_update.h"
 #include "ctrlm_vendor_network_factory.h"
+#ifndef DISABLE_DEVICESETTINGS
 #include "dsMgr.h"
 #include "dsRpc.h"
 #include "dsDisplay.h"
+#endif /* DISABLE_DEVICESETTINGS */
 #include <systemd/sd-daemon.h>
 #include <systemd/sd-bus.h>
 #include "xr_voice_sdk.h"
--- a/src/ctrlm_main_iarm.cpp
+++ b/src/ctrlm_main_iarm.cpp
@@ -34,8 +34,10 @@
 #include "ctrlm_network.h"
 #include "ctrlm_tr181.h"
 #include "ctrlm_utils.h"
+#ifndef DISABLE_DEVICESETTINGS
 #include "dsMgr.h"
 #include "dsRpc.h"
+#endif /* DISABLE_DEVICESETTINGS */
 
 static IARM_Result_t ctrlm_main_iarm_call_status_get(void *arg);
 static IARM_Result_t ctrlm_main_iarm_call_network_status_get(void *arg);
--- a/src/factory/CMakeLists.txt
+++ b/src/factory/CMakeLists.txt
@@ -47,7 +47,11 @@
    iarm/ctrlmf_iarm_control_manager.cpp
 )
 
-target_link_libraries(ctrlm-fta c rdkversion dbus-1 glib-2.0 IARMBus xr-voice-sdk pthread nopoll secure_wrapper ds)
+# DS_COMRPC migration: link ds only when DISABLE_DEVICESETTINGS is not set.
+if(NOT DISABLE_DEVICESETTINGS)
+   target_link_libraries(ctrlm-fta ds)
+endif()
+target_link_libraries(ctrlm-fta c rdkversion dbus-1 glib-2.0 IARMBus xr-voice-sdk pthread nopoll secure_wrapper)
 target_link_libraries(controlFactory c ctrlm-fta secure_wrapper)
 
 if(AUTH_ENABLED)
--- a/src/factory/ctrlmf_audio_control.cpp
+++ b/src/factory/ctrlmf_audio_control.cpp
@@ -5,7 +5,8 @@
 #include <rdkx_logger.h>
 #include <ctrlm_fta_lib.h>
 #include <ctrlmf_utils.h>
-// dsMgr includes
+// dsMgr includes — guarded by DISABLE_DEVICESETTINGS (DS_COMRPC migration)
+#ifndef DISABLE_DEVICESETTINGS
 #include "host.hpp"
 #include "exception.hpp"
 #include "videoOutputPort.hpp"
@@ -17,9 +18,11 @@
 #include "dsMgr.h"
 #include "dsRpc.h"
 #include "dsDisplay.h"
+#endif /* DISABLE_DEVICESETTINGS */
 // end dsMgr includes
 
 bool ctrlmf_audio_control_init(void) {
+#ifndef DISABLE_DEVICESETTINGS
    if(device::Manager::IsInitialized) {
       XLOGD_INFO("DSMgr already initialized");
       return(true);
@@ -33,9 +36,14 @@
       return(false);
    }
    return(true);
+#else
+   XLOGD_INFO("DSMgr disabled (DISABLE_DEVICESETTINGS)");
+   return(true);
+#endif /* DISABLE_DEVICESETTINGS */
 }
 
 bool ctrlmf_audio_control_term(void) {
+#ifndef DISABLE_DEVICESETTINGS
    try {
       if(device::Manager::IsInitialized) {
          device::Manager::DeInitialize();
@@ -46,9 +54,13 @@
       return(false);
    }
    return(true);
+#else
+   return(true);
+#endif /* DISABLE_DEVICESETTINGS */
 }
 
 bool ctrlmf_audio_control_mute(bool mute) {
+#ifndef DISABLE_DEVICESETTINGS
    if(!ctrlmf_is_initialized()) {
       XLOGD_ERROR("not initialized");
       return(false);
@@ -64,9 +76,14 @@
      return(false);
    }
    return(true);
+#else
+   XLOGD_INFO("Audio mute skipped (DISABLE_DEVICESETTINGS): mute=%d", mute);
+   return(true);
+#endif /* DISABLE_DEVICESETTINGS */
 }
 
 bool ctrlmf_audio_control_attenuate(bool enable, bool relative, double vol) {
+#ifndef DISABLE_DEVICESETTINGS
    if(!ctrlmf_is_initialized()) {
       XLOGD_ERROR("not initialized");
       return(false);
@@ -95,4 +112,8 @@
       return(false);
    }
    return(true);
+#else
+   XLOGD_INFO("Audio ducking skipped (DISABLE_DEVICESETTINGS): enable=%d", enable);
+   return(true);
+#endif /* DISABLE_DEVICESETTINGS */
 }
