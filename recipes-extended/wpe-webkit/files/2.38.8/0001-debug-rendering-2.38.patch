 namespace WebCore {
 
+// [GPUDEBUG] estimated native GL texture bytes per process for the 2.38 native-GLES WebGL path (no ANGLE backend).
+namespace GPUDebug238 {
+static std::mutex s_lock;
+static std::map<unsigned, std::map<unsigned, unsigned long long>> s_texBytes;
+static unsigned long long s_liveBytes = 0, s_peakBytes = 0, s_created = 0, s_deleted = 0, s_events = 0;
+
+static void onCreate(unsigned name)
+{
+    std::lock_guard<std::mutex> l(s_lock);
+    s_texBytes[name];
+    s_created++;
+}
+
+static void setLevel(unsigned name, unsigned key, unsigned long long bytes)
+{
+    std::lock_guard<std::mutex> l(s_lock);
+    unsigned long long& slot = s_texBytes[name][key];
+    s_liveBytes = s_liveBytes - slot + bytes;
+    slot = bytes;
+    if (s_liveBytes > s_peakBytes)
+        s_peakBytes = s_liveBytes;
+}
+
+static unsigned long long onDelete(unsigned name)
+{
+    std::lock_guard<std::mutex> l(s_lock);
+    unsigned long long freed = 0;
+    auto it = s_texBytes.find(name);
+    if (it != s_texBytes.end()) {
+        for (auto& level : it->second)
+            freed += level.second;
+        s_texBytes.erase(it);
+    }
+    s_liveBytes -= freed;
+    s_deleted++;
+    return freed;
+}
+
+static unsigned long long liveBytes()
+{
+    std::lock_guard<std::mutex> l(s_lock);
+    return s_liveBytes;
+}
+
+static bool shouldPeriodicDump()
+{
+    std::lock_guard<std::mutex> l(s_lock);
+    return !(++s_events % 25);
+}
+
+static void dumpProcFile(const char* path, const char* const keys[], size_t count)
+{
+    FILE* f = fopen(path, "r");
+    if (!f)
+        return;
+    char line[256];
+    while (fgets(line, sizeof(line), f)) {
+        for (size_t i = 0; i < count; ++i) {
+            if (!strncmp(line, keys[i], strlen(keys[i])))
+                fprintf(stderr, "[GPUDEBUG]   %s: %s", path, line);
+        }
+    }
+    fclose(f);
+}
+
+static void dumpStats(const char* reason)
+{
+    {
+        std::lock_guard<std::mutex> l(s_lock);
+        size_t b64k = 0, b256k = 0, b1m = 0, bBig = 0;
+        for (auto& texture : s_texBytes) {
+            unsigned long long bytes = 0;
+            for (auto& level : texture.second)
+                bytes += level.second;
+            if (bytes < 65536)
+                b64k++;
+            else if (bytes < 262144)
+                b256k++;
+            else if (bytes < 1048576)
+                b1m++;
+            else
+                bBig++;
+        }
+        fprintf(stderr, "[GPUDEBUG] STATS reason=%s pid=%d backend=NATIVE_GLES liveTex=%zu created=%llu destroyed=%llu liveBytes=%llu peakBytes=%llu hist[<64K=%zu <256K=%zu <1M=%zu >=1M=%zu]\n",
+            reason, getpid(), s_texBytes.size(), s_created, s_deleted, s_liveBytes, s_peakBytes, b64k, b256k, b1m, bBig);
+    }
+    static const char* const memKeys[] = { "MemFree", "MemAvailable", "CmaTotal", "CmaFree" };
+    static const char* const selfKeys[] = { "VmRSS", "VmSize" };
+    dumpProcFile("/proc/meminfo", memKeys, 4);
+    dumpProcFile("/proc/self/status", selfKeys, 2);
+    GPUDebugNexus::dump(reason);
+}
+
+static unsigned bytesPerPixel(GCGLenum format, GCGLenum type)
+{
+    if (type == GL_UNSIGNED_SHORT_5_6_5 || type == GL_UNSIGNED_SHORT_4_4_4_4 || type == GL_UNSIGNED_SHORT_5_5_5_1)
+        return 2;
+    switch (format) {
+    case GL_ALPHA:
+    case GL_LUMINANCE:
+        return 1;
+    case GL_LUMINANCE_ALPHA:
+        return 2;
+    case GL_RGB:
+        return 3;
+    default:
+        return 4;
+    }
+}
