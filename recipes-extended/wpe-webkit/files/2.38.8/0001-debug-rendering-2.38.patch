 void GraphicsContextGLOpenGL::synthesizeGLError(GCGLenum error)
@@ -2391,7 +2548,44 @@ void GraphicsContextGLOpenGL::texImage2DDirect(GCGLenum target, GCGLint level, G
     if (!makeContextCurrent())
         return;
 
+    GLint gpuDbgBound = 0;
+    ::glGetIntegerv(target == GL_TEXTURE_2D ? GL_TEXTURE_BINDING_2D : GL_TEXTURE_BINDING_CUBE_MAP, &gpuDbgBound);
+    unsigned long long gpuDbgEst = static_cast<unsigned long long>(width) * height * GPUDebug238::bytesPerPixel(format, type);
+    fprintf(stderr, "[GPUDEBUG] TEXIMAGE2D texture=%d target=0x%x level=%d width=%d height=%d approxBytes=%llu internalFormat=0x%x format=0x%x type=0x%x pixels=%p liveBytes=%llu backend=NATIVE_GLES\n",
+        gpuDbgBound, target, level, width, height, gpuDbgEst, internalformat, format, type, pixels, GPUDebug238::liveBytes());
+    GPUDebugNexus::Snapshot gpuDbgBefore;
+    bool gpuDbgMeasure = gpuDbgEst > 4 && GPUDebugNexus::takeSnapshot(gpuDbgBefore);
+    moveErrorsToSyntheticErrorList();
+
     ::glTexImage2D(target, level, internalformat, width, height, border, format, type, pixels);
+
+    // Errors are parked in the synthetic list so WebGL getError() still reports them in order.
+    bool gpuDbgOom = false;
+    for (unsigned i = 0; i < 100; ++i) {
+        GCGLenum error = ::glGetError();
+        if (error == GL_NO_ERROR)
+            break;
+        if (error == GL_OUT_OF_MEMORY)
+            gpuDbgOom = true;
+        m_syntheticErrors.add(error);
+    }
+    if (gpuDbgOom) {
+        static unsigned s_gpuDbgOomCount = 0;
+        ++s_gpuDbgOomCount;
+        fprintf(stderr, "[GPUDEBUG] GL_OOM #%u func=texImage2DDirect texture=%d %dx%d backend=NATIVE_GLES\n", s_gpuDbgOomCount, gpuDbgBound, width, height);
+        if (s_gpuDbgOomCount <= 5 || !(s_gpuDbgOomCount % 20))
+            GPUDebug238::dumpStats("GL_OUT_OF_MEMORY");
+        return;
+    }
+    GPUDebug238::setLevel(static_cast<unsigned>(gpuDbgBound), static_cast<unsigned>(target) * 64 + static_cast<unsigned>(level), gpuDbgEst);
+    GPUDebugNexus::Snapshot gpuDbgAfter;
+    if (gpuDbgMeasure && GPUDebugNexus::takeSnapshot(gpuDbgAfter)) {
+        char tag[128];
