 namespace WebCore {
 
+#if USE(LINUX_FTRACE)
+// Per-call GL markers, comparable to the 2.46 ANGLE gpu.angle events. They are very
+// verbose, so they also require WEBKIT_USE_FTRACE=1 plus WEBKIT_FTRACE_GL_CALLS=1.
+static bool glCallTracingEnabled()
+{
+    static const bool enabled = [] {
+        const char* value = getenv("WEBKIT_FTRACE_GL_CALLS");
+        return SystemTracingFTrace::isEnabled() && value && *value && *value != '0';
+    }();
+    return enabled;
+}
+
+class GLCallTraceScope {
+    WTF_MAKE_NONCOPYABLE(GLCallTraceScope);
+public:
+    explicit GLCallTraceScope(const char* name)
+        : m_name(glCallTracingEnabled() ? name : nullptr)
+    {
+    }
+
+    ~GLCallTraceScope()
+    {
+        if (m_name)
+            SystemTracingFTrace::instance().addMark('E', m_name);
+    }
+
+    bool enabled() const { return m_name; }
+
+private:
+    const char* m_name;
+};
+
+#define WEBGL_GL_CALL_TRACE(name, format, ...) \
+    GLCallTraceScope glCallTraceScope("gpu.gl:" name); \
+    if (glCallTraceScope.enabled()) \
+        SystemTracingFTrace::instance().addMark('B', "gpu.gl:" name, "m=" name "(" format ")", ##__VA_ARGS__)
+#else
+#define WEBGL_GL_CALL_TRACE(...) do { } while (0)
+#endif
+
 static ThreadSpecific<ShaderNameHash*>& getCurrentNameHashMapForShader()
 {
     static std::once_flag onceFlag;
