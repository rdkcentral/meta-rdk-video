diff --git a/Source/WebCore/platform/graphics/GPUDebugNexus.h b/Source/WebCore/platform/graphics/GPUDebugNexus.h
new file mode 100644
index 000000000000..48cf9f41c957
--- /dev/null
+++ b/Source/WebCore/platform/graphics/GPUDebugNexus.h
@@ -0,0 +1,401 @@
+// [GPUDEBUG] Debug-only Broadcom Nexus heap probe. Self-contained so it can be included from WebCore and ANGLE.
+// Nexus is resolved with dlopen/dlsym, so no build-system or link changes are needed.
+// Set GPUDBG_NO_NEXUS=1 in the WPEWebProcess environment to disable all Nexus queries.
+#pragma once
+
+#include <dlfcn.h>
+#include <dirent.h>
+#include <limits.h>
+#include <map>
+#include <mutex>
+#include <string>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+namespace GPUDebugNexus {
+
+static constexpr int kMaxHeaps = 32;
+
+// Mirrors the leading members of NEXUS_ClientConfiguration (nexus_base_types_client.h); oversized buffer absorbs the rest.
+struct ClientConfigurationPrefix {
+    int mode;
+    void* heap[kMaxHeaps];
+};
+
+// Mirrors NEXUS_MemoryStatus (nexus_memory.h); identical in the 2.38 and 2.46 sysroots.
+struct MemoryStatus {
+    unsigned memoryType;
+    unsigned heapType;
+    unsigned memcIndex;
+    uint64_t offset;
+    void* addr;
+    unsigned size;
+    unsigned free;
+    unsigned alignment;
+    unsigned numAllocs;
+    unsigned numFreeBlocks;
+    unsigned largestFreeBlock;
+    unsigned highWatermark;
+    int memoryOsType;
+};
+
+struct Snapshot {
+    int count { 0 };
+    void* heap[kMaxHeaps] { };
+    MemoryStatus status[kMaxHeaps] { };
+};
+
+typedef void (*GetClientConfigurationFn)(void*);
+typedef unsigned (*HeapGetStatusFn)(void*, void*);
+
+struct State {
+    std::mutex lock;
+    bool initialized { false };
+    bool disabled { false };
+    GetClientConfigurationFn getClientConfiguration { nullptr };
+    HeapGetStatusFn heapGetStatus { nullptr };
+};
+
+static inline State& state()
+{
+    static State s;
+    return s;
+}
+
+static inline bool ensureInitialized(State& s)
+{
+    if (s.initialized)
+        return !s.disabled;
+    if (getenv("GPUDBG_NO_NEXUS")) {
+        s.initialized = true;
+        s.disabled = true;
+        fprintf(stderr, "[GPUDEBUG] NEXUS probe disabled by GPUDBG_NO_NEXUS\n");
+        return false;
+    }
+    // Only probe when the GPU driver already loaded (and joined) Nexus in this process; retry on later calls.
+    void* handle = dlopen("libnexus.so", RTLD_LAZY | RTLD_NOLOAD);
+    if (!handle) {
+        static bool reported = false;
+        if (!reported) {
+            reported = true;
+            fprintf(stderr, "[GPUDEBUG] NEXUS probe: libnexus.so not loaded yet in pid=%d, will retry\n", getpid());
+        }
+        return false;
+    }
+    s.initialized = true;
+    s.getClientConfiguration = reinterpret_cast<GetClientConfigurationFn>(dlsym(handle, "NEXUS_Platform_GetClientConfiguration"));
+    s.heapGetStatus = reinterpret_cast<HeapGetStatusFn>(dlsym(handle, "NEXUS_Heap_GetStatus"));
+    if (!s.getClientConfiguration || !s.heapGetStatus) {
+        s.disabled = true;
+        fprintf(stderr, "[GPUDEBUG] NEXUS probe unavailable getClientConfiguration=%p heapGetStatus=%p\n",
+            reinterpret_cast<void*>(s.getClientConfiguration), reinterpret_cast<void*>(s.heapGetStatus));
+        return false;
+    }
+    fprintf(stderr, "[GPUDEBUG] NEXUS probe ready pid=%d\n", getpid());
+    return true;
+}
+
+static inline bool takeSnapshot(Snapshot& out)
+{
+    State& s = state();
+    std::lock_guard<std::mutex> guard(s.lock);
+    if (!ensureInitialized(s))
+        return false;
+
+    alignas(8) static unsigned char configBuffer[16384];
+    memset(configBuffer, 0, sizeof(configBuffer));
+    s.getClientConfiguration(configBuffer);
+    auto* config = reinterpret_cast<ClientConfigurationPrefix*>(configBuffer);
+
+    out.count = 0;
+    for (int i = 0; i < kMaxHeaps; ++i) {
+        void* heap = config->heap[i];
+        if (!heap)
+            continue;
+        alignas(8) unsigned char statusBuffer[1024];
+        memset(statusBuffer, 0, sizeof(statusBuffer));
+        if (s.heapGetStatus(heap, statusBuffer))
+            continue;
+        out.heap[out.count] = heap;
+        memcpy(&out.status[out.count], statusBuffer, sizeof(MemoryStatus));
+        out.count++;
+    }
+    return out.count > 0;
+}
+
+// heapType bits: 0x1 MAIN, 0x2 PICTURE_BUFFERS, 0x10 GRAPHICS, 0x20 SECONDARY_GRAPHICS, 0x80 SECURE_GRAPHICS.
+static inline void dump(const char* reason)
+{
+    Snapshot snap;
+    if (!takeSnapshot(snap)) {
+        static unsigned s_unavailableReports = 0;
+        if (s_unavailableReports++ < 3)
+            fprintf(stderr, "[GPUDEBUG] NEXUS_HEAPS reason=%s unavailable (no heaps visible to pid=%d)\n", reason, getpid());
+        return;
+    }
+    for (int i = 0; i < snap.count; ++i) {
+        const MemoryStatus& st = snap.status[i];
+        fprintf(stderr, "[GPUDEBUG] NEXUS_HEAP reason=%s pid=%d idx=%d heap=%p heapType=0x%x memType=0x%x memc=%u sizeKB=%u freeKB=%u usedKB=%u largestFreeKB=%u numAllocs=%u freeBlocks=%u highWatermarkKB=%u\n",
+            reason, getpid(), i, snap.heap[i], st.heapType, st.memoryType, st.memcIndex, st.size / 1024, st.free / 1024,
+            (st.size - st.free) / 1024, st.largestFreeBlock / 1024, st.numAllocs, st.numFreeBlocks, st.highWatermark / 1024);
+    }
+}
+
+// Prints only heaps whose free size changed between two snapshots; used to measure the real cost of one allocation.
+static inline void dumpDelta(const char* tag, const Snapshot& before, const Snapshot& after, unsigned long long estimatedBytes)
+{
+    bool printed = false;
+    for (int i = 0; i < after.count; ++i) {
+        for (int j = 0; j < before.count; ++j) {
+            if (before.heap[j] != after.heap[i])
+                continue;
+            long long delta = static_cast<long long>(before.status[j].free) - static_cast<long long>(after.status[i].free);
+            int allocDelta = static_cast<int>(after.status[i].numAllocs) - static_cast<int>(before.status[j].numAllocs);
+            if (delta || allocDelta) {
+                fprintf(stderr, "[GPUDEBUG] NEXUS_DELTA %s estBytes=%llu heapType=0x%x usedDeltaBytes=%lld allocDelta=%d freeKB=%u largestFreeKB=%u\n",
+                    tag, estimatedBytes, after.status[i].heapType, delta, allocDelta, after.status[i].free / 1024, after.status[i].largestFreeBlock / 1024);
+                printed = true;
+            }
+        }
+    }
+    if (!printed)
+        fprintf(stderr, "[GPUDEBUG] NEXUS_DELTA %s estBytes=%llu usedDeltaBytes=0 (no heap change; driver may sub-allocate from a pool)\n", tag, estimatedBytes);
+}
+
+} // namespace GPUDebugNexus
+
+// ---- Process / container GPU-memory breakdown (reads /proc only, no Broadcom API) ----
+namespace GPUDebugProc {
+
+// Logs the env that points WebKit's memory-pressure handler at a platform GPU-memory file, and that file's value.
+static inline void dumpGpuFileConfig(const char* reason)
+{
+    const char* file = getenv("WPE_POLL_MAX_MEMORY_GPU_FILE");
+    const char* limit = getenv("WPE_POLL_MAX_MEMORY_GPU");
+    const char* inRss = getenv("WPE_POLL_GPU_IN_FOOTPRINT");
+    char value[128] = "n/a";
+    if (file && *file) {
+        FILE* f = fopen(file, "r");
+        if (f) {
+            if (!fgets(value, sizeof(value), f))
+                strcpy(value, "(empty)");
+            fclose(f);
+            size_t n = strlen(value);
+            while (n && (value[n - 1] == '\n' || value[n - 1] == '\r'))
+                value[--n] = 0;
+        } else
+            strcpy(value, "(unreadable)");
+    }
+    fprintf(stderr, "[GPUDEBUG] GPUFILE reason=%s pid=%d WPE_POLL_MAX_MEMORY_GPU_FILE=%s value=%s WPE_POLL_MAX_MEMORY_GPU=%s WPE_POLL_GPU_IN_FOOTPRINT=%s\n",
+        reason, getpid(), file ? file : "(unset)", value, limit ? limit : "(unset)", inRss ? inRss : "(unset)");
+}
+
+// Sums Rss/Pss/Size per mapped path for the interesting classes of mappings in the given process.
+static inline void dumpMappings(const char* reason, const char* pidStr)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/%s/smaps", pidStr);
+    FILE* f = fopen(path, "r");
+    if (!f) {
+        fprintf(stderr, "[GPUDEBUG] MAPS reason=%s pid=%s unreadable\n", reason, pidStr);
+        return;
+    }
+    struct Totals { unsigned long sizeKB = 0, rssKB = 0, pssKB = 0; unsigned count = 0; };
+    std::map<std::string, Totals> byClass;
+    char line[1024];
+    std::string current = "anon";
+    Totals* cur = nullptr;
+    while (fgets(line, sizeof(line), f)) {
+        unsigned long start, end;
+        char perms[8], name[800];
+        name[0] = 0;
+        if (sscanf(line, "%lx-%lx %7s %*s %*s %*s %799[^\n]", &start, &end, perms, name) >= 3) {
+            const char* p = name;
+            while (*p == ' ')
+                ++p;
+            std::string key;
+            if (!*p)
+                key = "[anon]";
+            else if (strstr(p, "nexus") || strstr(p, "nx_") || strstr(p, "nxmem"))
+                key = std::string("GFX:") + p;
+            else if (strstr(p, "/dev/dri") || strstr(p, "dmabuf") || strstr(p, "ion") || strstr(p, "/dev/mali") || strstr(p, "/dev/v3d") || strstr(p, "kgsl") || strstr(p, "drm"))
+                key = std::string("GFX:") + p;
+            else if (!strncmp(p, "/dev/", 5))
+                key = std::string("DEV:") + p;
+            else if (!strncmp(p, "[heap]", 6) || !strncmp(p, "[stack", 6))
+                key = p;
+            else if (strstr(p, ".so"))
+                key = "libs";
+            else
+                key = "files";
+            Totals& t = byClass[key];
+            t.count++;
+            t.sizeKB += (end - start) / 1024;
+            cur = &t;
+            continue;
+        }
+        unsigned long v;
+        if (cur && sscanf(line, "Rss: %lu kB", &v) == 1)
+            cur->rssKB += v;
+        else if (cur && sscanf(line, "Pss: %lu kB", &v) == 1)
+            cur->pssKB += v;
+    }
+    fclose(f);
+    for (auto& e : byClass) {
+        const bool gfxLike = !strncmp(e.first.c_str(), "GFX:", 4) || !strncmp(e.first.c_str(), "DEV:", 4);
+        if (!gfxLike && e.second.rssKB < 4096)
+            continue;
+        fprintf(stderr, "[GPUDEBUG] MAPS reason=%s pid=%s class=%s maps=%u sizeKB=%lu rssKB=%lu pssKB=%lu\n",
+            reason, pidStr, e.first.c_str(), e.second.count, e.second.sizeKB, e.second.rssKB, e.second.pssKB);
+    }
+}
+
+// Counts open file descriptors by target class (dmabuf, /dev/nexus, drm, sockets, ...).
+static inline void dumpFds(const char* reason, const char* pidStr)
+{
+    char dirPath[64];
+    snprintf(dirPath, sizeof(dirPath), "/proc/%s/fd", pidStr);
+    DIR* d = opendir(dirPath);
+    if (!d)
+        return;
+    std::map<std::string, unsigned> counts;
+    struct dirent* de;
+    while ((de = readdir(d))) {
+        if (de->d_name[0] == '.')
+            continue;
+        char lp[96], target[PATH_MAX];
+        snprintf(lp, sizeof(lp), "%s/%s", dirPath, de->d_name);
+        ssize_t n = readlink(lp, target, sizeof(target) - 1);
+        if (n <= 0)
+            continue;
+        target[n] = 0;
+        std::string t = target;
+        if (t.find("dmabuf") != std::string::npos)
+            counts["dmabuf"]++;
+        else if (t.find("nexus") != std::string::npos || t.find("/dev/dri") != std::string::npos || t.find("/dev/v3d") != std::string::npos || t.find("/dev/mali") != std::string::npos || t.find("/dev/ion") != std::string::npos)
+            counts[t]++;
+        else if (!strncmp(target, "socket:", 7))
+            counts["socket"]++;
+        else if (!strncmp(target, "anon_inode:", 11))
+            counts["anon_inode"]++;
+        else if (!strncmp(target, "/dev/", 5))
+            counts[t]++;
+        else
+            counts["other"]++;
+    }
+    closedir(d);
+    for (auto& e : counts)
+        fprintf(stderr, "[GPUDEBUG] FDS reason=%s pid=%s target=%s count=%u\n", reason, pidStr, e.first.c_str(), e.second);
+}
+
+// Lists every process in the same memory cgroup with its comm, RSS and Pss so the whole container is accounted for.
+static inline void dumpContainerProcesses(const char* reason)
+{
+    char cg[PATH_MAX] = "";
+    FILE* f = fopen("/proc/self/cgroup", "r");
+    if (f) {
+        char line[512];
+        while (fgets(line, sizeof(line), f)) {
+            if (strstr(line, "memory") || line[0] == '0') {
+                const char* p = strchr(line, ':');
+                if (p && (p = strchr(p + 1, ':'))) {
+                    snprintf(cg, sizeof(cg), "%s", p + 1);
+                    size_t n = strlen(cg);
+                    while (n && (cg[n - 1] == '\n' || cg[n - 1] == '\r'))
+                        cg[--n] = 0;
+                    break;
+                }
+            }
+        }
+        fclose(f);
+    }
+    fprintf(stderr, "[GPUDEBUG] CGROUP reason=%s pid=%d path=%s\n", reason, getpid(), cg[0] ? cg : "(unknown)");
+
+    const char* roots[] = { "/sys/fs/cgroup/memory", "/sys/fs/cgroup" };
+    for (const char* root : roots) {
+        static const char* const files[] = { "memory.usage_in_bytes", "memory.limit_in_bytes", "memory.max_usage_in_bytes", "memory.current", "memory.max", "memory.peak" };
+        for (const char* name : files) {
+            char p[PATH_MAX];
+            snprintf(p, sizeof(p), "%s%s/%s", root, cg, name);
+            FILE* c = fopen(p, "r");
+            if (!c)
+                continue;
+            char v[64] = "";
+            if (fgets(v, sizeof(v), c)) {
+                size_t n = strlen(v);
+                while (n && v[n - 1] == '\n')
+                    v[--n] = 0;
+                fprintf(stderr, "[GPUDEBUG] CGROUP reason=%s file=%s value=%s\n", reason, p, v);
+            }
+            fclose(c);
+        }
+        char sp[PATH_MAX];
+        snprintf(sp, sizeof(sp), "%s%s/memory.stat", root, cg);
+        FILE* s = fopen(sp, "r");
+        if (s) {
+            char l[160];
+            while (fgets(l, sizeof(l), s)) {
+                if (!strncmp(l, "cache ", 6) || !strncmp(l, "rss ", 4) || !strncmp(l, "mapped_file ", 12) || !strncmp(l, "shmem ", 6)
+                    || !strncmp(l, "file ", 5) || !strncmp(l, "anon ", 5) || !strncmp(l, "file_mapped ", 12) || !strncmp(l, "kernel_stack ", 13)
+                    || !strncmp(l, "slab ", 5) || !strncmp(l, "sock ", 5))
+                    fprintf(stderr, "[GPUDEBUG] CGROUP reason=%s stat %s", reason, l);
+            }
+            fclose(s);
+        }
+        char tp[PATH_MAX];
+        snprintf(tp, sizeof(tp), "%s%s/cgroup.procs", root, cg);
+        FILE* tf = fopen(tp, "r");
+        if (!tf) {
+            snprintf(tp, sizeof(tp), "%s%s/tasks", root, cg);
+            tf = fopen(tp, "r");
+        }
+        if (tf) {
+            char l[32];
+            int seen = 0;
+            while (fgets(l, sizeof(l), tf) && seen < 40) {
+                int pid = atoi(l);
+                if (pid <= 0)
+                    continue;
+                char sp2[64], comm[64] = "?";
+                snprintf(sp2, sizeof(sp2), "/proc/%d/comm", pid);
+                if (FILE* cf = fopen(sp2, "r")) {
+                    if (fgets(comm, sizeof(comm), cf)) {
+                        size_t n = strlen(comm);
+                        while (n && comm[n - 1] == '\n')
+                            comm[--n] = 0;
+                    }
+                    fclose(cf);
+                }
+                unsigned long rss = 0;
+                snprintf(sp2, sizeof(sp2), "/proc/%d/status", pid);
+                if (FILE* sf = fopen(sp2, "r")) {
+                    char sl[160];
+                    while (fgets(sl, sizeof(sl), sf))
+                        if (sscanf(sl, "VmRSS: %lu kB", &rss) == 1)
+                            break;
+                    fclose(sf);
+                }
+                fprintf(stderr, "[GPUDEBUG] CGROUP reason=%s proc pid=%d comm=%s rssKB=%lu\n", reason, pid, comm, rss);
+                ++seen;
+            }
+            fclose(tf);
+            break;
+        }
+    }
+}
+
+// One-call full breakdown; used at OOM, at policy changes and periodically.
+static inline void dumpAll(const char* reason)
+{
+    char self[32];
+    snprintf(self, sizeof(self), "%d", getpid());
+    dumpGpuFileConfig(reason);
+    dumpMappings(reason, self);
+    dumpFds(reason, self);
+    dumpContainerProcesses(reason);
+}
