+void AddCodecIfSupported(std::vector<webrtc::SdpVideoFormat>* supportedFormats)
+{
+	printf("%d %s KKP\n",__LINE__,__PRETTY_FUNCTION__);fflush(stdout);
+    auto constrainedBaseline = webrtc::SdpVideoFormat(
+        cricket::kH264CodecName,
+        {
+            { cricket::kH264FmtpProfileLevelId, cricket::kH264ProfileLevelConstrainedBaseline },
+            { cricket::kH264FmtpLevelAsymmetryAllowed, "1" },
+            { cricket::kH264FmtpPacketizationMode, "1" }
+        });
+
+    supportedFormats->push_back(constrainedBaseline);
+
+    auto constrainedHigh = webrtc::SdpVideoFormat(
+        cricket::kH264CodecName,
+        {
+            { cricket::kH264FmtpProfileLevelId, cricket::kH264ProfileLevelConstrainedHigh },
+            { cricket::kH264FmtpLevelAsymmetryAllowed, "1" },
+            { cricket::kH264FmtpPacketizationMode, "1" }
+        });
+
+    supportedFormats->push_back(constrainedHigh);
+}
 };
 
