+#if USE(LINUX_FTRACE)
+void initializeANGLEFTrace(void* display)
+{
+    if (!SystemTracingFTrace::isEnabled())
+        return;
+
+    auto getPlatform = reinterpret_cast<angle::GetDisplayPlatformFunc>(EGL_GetProcAddress("ANGLEGetDisplayPlatform"));
+    angle::PlatformMethods* methods = nullptr;
+    if (!getPlatform || !getPlatform(display, angle::g_PlatformMethodNames, angle::g_NumPlatformMethods, nullptr, &methods) || !methods) {
+        WTFLogAlways("Failed to initialize ANGLE ftrace platform callbacks");
+        return;
+    }
+    methods->getTraceCategoryEnabledFlag = [](angle::PlatformMethods*, const char* category) {
+        return reinterpret_cast<const unsigned char*>(category);
+    };
+    methods->monotonicallyIncreasingTime = [](angle::PlatformMethods*) {
+        return MonotonicTime::now().secondsSinceEpoch().value();
+    };
+    methods->addTraceEvent = [](angle::PlatformMethods*, char phase, const unsigned char* category, const char* name,
+        unsigned long long, double, int numArgs, const char** argNames, const unsigned char* argTypes,
+        const unsigned long long* argValues, unsigned char) -> angle::TraceEventHandle {
+        SystemTracingFTrace::instance().addTraceEvent(phase, category, name, numArgs, argNames, argTypes, argValues);
+        return 0;
+    };
+}
+#endif
