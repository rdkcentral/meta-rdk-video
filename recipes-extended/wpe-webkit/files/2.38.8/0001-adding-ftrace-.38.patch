diff --git a/Source/WTF/wtf/SystemTracing.h b/Source/WTF/wtf/SystemTracing.h
index 4a1ccdcaa96e..edb10fd5b532 100644
--- a/Source/WTF/wtf/SystemTracing.h
+++ b/Source/WTF/wtf/SystemTracing.h
@@ -146,12 +146,18 @@ enum TracePointCode {
 
 #ifdef __cplusplus
 
+#if USE(LINUX_FTRACE)
+#include <wtf/linux/SystemTracingFTrace.h>
+#endif
+
 namespace WTF {
 
 inline void tracePoint(TracePointCode code, uint64_t data1 = 0, uint64_t data2 = 0, uint64_t data3 = 0, uint64_t data4 = 0)
 {
 #if HAVE(KDEBUG_H)
     kdebug_trace(ARIADNEDBG_CODE(WEBKIT_COMPONENT, code), data1, data2, data3, data4);
+#elif USE(LINUX_FTRACE)
+    SystemTracingFTrace::instance().tracePoint(code, data1, data2, data3, data4);
 #else
     UNUSED_PARAM(code);
     UNUSED_PARAM(data1);
@@ -185,6 +191,41 @@ private:
 using WTF::TraceScope;
 using WTF::tracePoint;
 
+#if USE(LINUX_FTRACE)
+namespace WTF {
+
+class FTraceScope {
+public:
+    explicit FTraceScope(const char* name)
+        : m_name(name)
+        , m_enabled(SystemTracingFTrace::isEnabled())
+    {
+        if (m_enabled)
+            SystemTracingFTrace::instance().addMark('B', m_name);
+    }
+
+    ~FTraceScope()
+    {
+        if (m_enabled)
+            SystemTracingFTrace::instance().addMark('E', m_name);
+    }
+
+    FTraceScope(const FTraceScope&) = delete;
+    FTraceScope& operator=(const FTraceScope&) = delete;
+
+private:
+    const char* m_name;
+    bool m_enabled;
+};
+
+}
+#define WTF_FTRACE_SCOPE_VARIABLE(line) WTF_FTRACE_SCOPE_VARIABLE_IMPL(line)
+#define WTF_FTRACE_SCOPE_VARIABLE_IMPL(line) ftraceScope##line
+#define WTF_FTRACE_SCOPE(name) WTF::FTraceScope WTF_FTRACE_SCOPE_VARIABLE(__LINE__)(name)
+#else
+#define WTF_FTRACE_SCOPE(name) do { } while (0)
+#endif
+
 #endif // __cplusplus
 
 #if HAVE(OS_SIGNPOST)
@@ -230,6 +271,24 @@ do { \
 #define WTFEndSignpostIntervalAlways(name, format, ...) \
     do { os_signpost_interval_end(WTFSignpostLogHandle(), OS_SIGNPOST_ID_EXCLUSIVE, name, format, ##__VA_ARGS__); } while (0)
 
+#elif USE(LINUX_FTRACE) && defined(__cplusplus)
+
+#define WTFEmitSignpostWithPhase(phase, pointer, name, ...) \
+    do { \
+        if (SystemTracingFTrace::isEnabled()) { \
+            SystemTracingFTrace::instance().addSignpost(phase, #name, static_cast<const void*>(pointer), ##__VA_ARGS__); \
+        } \
+    } while (0)
+
+#define WTFEmitSignpost(pointer, name, ...) WTFEmitSignpostWithPhase('I', pointer, name, ##__VA_ARGS__)
+#define WTFBeginSignpost(pointer, name, ...) WTFEmitSignpostWithPhase('B', pointer, name, ##__VA_ARGS__)
+#define WTFEndSignpost(pointer, name, ...) WTFEmitSignpostWithPhase('E', pointer, name, ##__VA_ARGS__)
+
+#define WTFEmitSignpostAlways(name, format, ...) do { } while (0)
+#define WTFBeginSignpostIntervalAlways(name, format, ...) do { } while (0)
+#define WTFBeginAnimationSignpostIntervalAlways(name, format, ...) do { } while (0)
+#define WTFEndSignpostIntervalAlways(name, format, ...) do { } while (0)
+
 #else
 
 #define WTFEmitSignpost(pointer, name, ...) do { } while (0)
diff --git a/Source/WTF/wtf/linux/SystemTracingFTrace.h b/Source/WTF/wtf/linux/SystemTracingFTrace.h
new file mode 100644
index 000000000000..bfd90abac6a4
--- /dev/null
+++ b/Source/WTF/wtf/linux/SystemTracingFTrace.h
@@ -0,0 +1,483 @@
+/*
