+// ---- Process / container GPU-memory breakdown (reads /proc only, no Broadcom API) ----
+namespace GPUDebugProc {
+
+// Logs the env that points WebKit's memory-pressure handler at a platform GPU-memory file, and that file's value.
+static inline void dumpGpuFileConfig(const char* reason)
+{
+    const char* file = getenv("WPE_POLL_MAX_MEMORY_GPU_FILE");
+    const char* limit = getenv("WPE_POLL_MAX_MEMORY_GPU");
+    const char* inRss = getenv("WPE_POLL_GPU_IN_FOOTPRINT");
+    char value[128] = "n/a";
+    if (file && *file) {
+        FILE* f = fopen(file, "r");
+        if (f) {
+            if (!fgets(value, sizeof(value), f))
+                strcpy(value, "(empty)");
+            fclose(f);
+            size_t n = strlen(value);
+            while (n && (value[n - 1] == '\n' || value[n - 1] == '\r'))
+                value[--n] = 0;
+        } else
+            strcpy(value, "(unreadable)");
+    }
+    fprintf(stderr, "[GPUDEBUG] GPUFILE reason=%s pid=%d WPE_POLL_MAX_MEMORY_GPU_FILE=%s value=%s WPE_POLL_MAX_MEMORY_GPU=%s WPE_POLL_GPU_IN_FOOTPRINT=%s\n",
+        reason, getpid(), file ? file : "(unset)", value, limit ? limit : "(unset)", inRss ? inRss : "(unset)");
+}
+
+// Sums Rss/Pss/Size per mapped path for the interesting classes of mappings in the given process.
+static inline void dumpMappings(const char* reason, const char* pidStr)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/%s/smaps", pidStr);
+    FILE* f = fopen(path, "r");
+    if (!f) {
+        fprintf(stderr, "[GPUDEBUG] MAPS reason=%s pid=%s unreadable\n", reason, pidStr);
+        return;
+    }
+    struct Totals { unsigned long sizeKB = 0, rssKB = 0, pssKB = 0; unsigned count = 0; };
+    std::map<std::string, Totals> byClass;
+    char line[1024];
+    std::string current = "anon";
+    Totals* cur = nullptr;
+    while (fgets(line, sizeof(line), f)) {
+        unsigned long start, end;
+        char perms[8], name[800];
+        name[0] = 0;
+        if (sscanf(line, "%lx-%lx %7s %*s %*s %*s %799[^\n]", &start, &end, perms, name) >= 3) {
+            const char* p = name;
+            while (*p == ' ')
+                ++p;
+            std::string key;
+            if (!*p)
+                key = "[anon]";
+            else if (strstr(p, "nexus") || strstr(p, "nx_") || strstr(p, "nxmem"))
+                key = std::string("GFX:") + p;
+            else if (strstr(p, "/dev/dri") || strstr(p, "dmabuf") || strstr(p, "ion") || strstr(p, "/dev/mali") || strstr(p, "/dev/v3d") || strstr(p, "kgsl") || strstr(p, "drm"))
+                key = std::string("GFX:") + p;
+            else if (!strncmp(p, "/dev/", 5))
+                key = std::string("DEV:") + p;
+            else if (!strncmp(p, "[heap]", 6) || !strncmp(p, "[stack", 6))
+                key = p;
+            else if (strstr(p, ".so"))
+                key = "libs";
+            else
+                key = "files";
+            Totals& t = byClass[key];
+            t.count++;
+            t.sizeKB += (end - start) / 1024;
+            cur = &t;
+            continue;
+        }
+        unsigned long v;
+        if (cur && sscanf(line, "Rss: %lu kB", &v) == 1)
+            cur->rssKB += v;
+        else if (cur && sscanf(line, "Pss: %lu kB", &v) == 1)
+            cur->pssKB += v;
+    }
+    fclose(f);
+    for (auto& e : byClass) {
+        const bool gfxLike = !strncmp(e.first.c_str(), "GFX:", 4) || !strncmp(e.first.c_str(), "DEV:", 4);
+        if (!gfxLike && e.second.rssKB < 4096)
+            continue;
+        fprintf(stderr, "[GPUDEBUG] MAPS reason=%s pid=%s class=%s maps=%u sizeKB=%lu rssKB=%lu pssKB=%lu\n",
+            reason, pidStr, e.first.c_str(), e.second.count, e.second.sizeKB, e.second.rssKB, e.second.pssKB);
+    }
+}
+
+// Counts open file descriptors by target class (dmabuf, /dev/nexus, drm, sockets, ...).
+static inline void dumpFds(const char* reason, const char* pidStr)
+{
+    char dirPath[64];
+    snprintf(dirPath, sizeof(dirPath), "/proc/%s/fd", pidStr);
+    DIR* d = opendir(dirPath);
+    if (!d)
+        return;
+    std::map<std::string, unsigned> counts;
+    struct dirent* de;
+    while ((de = readdir(d))) {
+        if (de->d_name[0] == '.')
+            continue;
+        char lp[96], target[PATH_MAX];
+        snprintf(lp, sizeof(lp), "%s/%s", dirPath, de->d_name);
+        ssize_t n = readlink(lp, target, sizeof(target) - 1);
+        if (n <= 0)
+            continue;
+        target[n] = 0;
+        std::string t = target;
+        if (t.find("dmabuf") != std::string::npos)
+            counts["dmabuf"]++;
+        else if (t.find("nexus") != std::string::npos || t.find("/dev/dri") != std::string::npos || t.find("/dev/v3d") != std::string::npos || t.find("/dev/mali") != std::string::npos || t.find("/dev/ion") != std::string::npos)
+            counts[t]++;
+        else if (!strncmp(target, "socket:", 7))
+            counts["socket"]++;
+        else if (!strncmp(target, "anon_inode:", 11))
+            counts["anon_inode"]++;
+        else if (!strncmp(target, "/dev/", 5))
+            counts[t]++;
+        else
+            counts["other"]++;
+    }
+    closedir(d);
+    for (auto& e : counts)
+        fprintf(stderr, "[GPUDEBUG] FDS reason=%s pid=%s target=%s count=%u\n", reason, pidStr, e.first.c_str(), e.second);
+}
+
+// Lists every process in the same memory cgroup with its comm, RSS and Pss so the whole container is accounted for.
+static inline void dumpContainerProcesses(const char* reason)
+{
+    char cg[PATH_MAX] = "";
+    FILE* f = fopen("/proc/self/cgroup", "r");
+    if (f) {
+        char line[512];
+        while (fgets(line, sizeof(line), f)) {
+            if (strstr(line, "memory") || line[0] == '0') {
+                const char* p = strchr(line, ':');
+                if (p && (p = strchr(p + 1, ':'))) {
+                    snprintf(cg, sizeof(cg), "%s", p + 1);
+                    size_t n = strlen(cg);
+                    while (n && (cg[n - 1] == '\n' || cg[n - 1] == '\r'))
+                        cg[--n] = 0;
+                    break;
+                }
+            }
+        }
+        fclose(f);
+    }
+    fprintf(stderr, "[GPUDEBUG] CGROUP reason=%s pid=%d path=%s\n", reason, getpid(), cg[0] ? cg : "(unknown)");
+
+    const char* roots[] = { "/sys/fs/cgroup/memory", "/sys/fs/cgroup" };
+    for (const char* root : roots) {
+        static const char* const files[] = { "memory.usage_in_bytes", "memory.limit_in_bytes", "memory.max_usage_in_bytes", "memory.current", "memory.max", "memory.peak" };
+        for (const char* name : files) {
+            char p[PATH_MAX];
+            snprintf(p, sizeof(p), "%s%s/%s", root, cg, name);
+            FILE* c = fopen(p, "r");
+            if (!c)
+                continue;
+            char v[64] = "";
+            if (fgets(v, sizeof(v), c)) {
+                size_t n = strlen(v);
+                while (n && v[n - 1] == '\n')
+                    v[--n] = 0;
+                fprintf(stderr, "[GPUDEBUG] CGROUP reason=%s file=%s value=%s\n", reason, p, v);
+            }
+            fclose(c);
+        }
+        char sp[PATH_MAX];
+        snprintf(sp, sizeof(sp), "%s%s/memory.stat", root, cg);
+        FILE* s = fopen(sp, "r");
+        if (s) {
+            char l[160];
+            while (fgets(l, sizeof(l), s)) {
+                if (!strncmp(l, "cache ", 6) || !strncmp(l, "rss ", 4) || !strncmp(l, "mapped_file ", 12) || !strncmp(l, "shmem ", 6)
+                    || !strncmp(l, "file ", 5) || !strncmp(l, "anon ", 5) || !strncmp(l, "file_mapped ", 12) || !strncmp(l, "kernel_stack ", 13)
+                    || !strncmp(l, "slab ", 5) || !strncmp(l, "sock ", 5))
+                    fprintf(stderr, "[GPUDEBUG] CGROUP reason=%s stat %s", reason, l);
+            }
+            fclose(s);
+        }
+        char tp[PATH_MAX];
+        snprintf(tp, sizeof(tp), "%s%s/cgroup.procs", root, cg);
+        FILE* tf = fopen(tp, "r");
+        if (!tf) {
+            snprintf(tp, sizeof(tp), "%s%s/tasks", root, cg);
+            tf = fopen(tp, "r");
+        }
+        if (tf) {
+            char l[32];
+            int seen = 0;
+            while (fgets(l, sizeof(l), tf) && seen < 40) {
+                int pid = atoi(l);
+                if (pid <= 0)
+                    continue;
+                char sp2[64], comm[64] = "?";
+                snprintf(sp2, sizeof(sp2), "/proc/%d/comm", pid);
+                if (FILE* cf = fopen(sp2, "r")) {
+                    if (fgets(comm, sizeof(comm), cf)) {
+                        size_t n = strlen(comm);
+                        while (n && comm[n - 1] == '\n')
+                            comm[--n] = 0;
+                    }
+                    fclose(cf);
+                }
+                unsigned long rss = 0;
+                snprintf(sp2, sizeof(sp2), "/proc/%d/status", pid);
+                if (FILE* sf = fopen(sp2, "r")) {
+                    char sl[160];
+                    while (fgets(sl, sizeof(sl), sf))
+                        if (sscanf(sl, "VmRSS: %lu kB", &rss) == 1)
+                            break;
+                    fclose(sf);
+                }
+                fprintf(stderr, "[GPUDEBUG] CGROUP reason=%s proc pid=%d comm=%s rssKB=%lu\n", reason, pid, comm, rss);
+                ++seen;
+            }
+            fclose(tf);
+            break;
+        }
+    }
+}
+
+// One-call full breakdown; used at OOM, at policy changes and periodically.
+static inline void dumpAll(const char* reason)
+{
+    char self[32];
+    snprintf(self, sizeof(self), "%d", getpid());
+    dumpGpuFileConfig(reason);
+    dumpMappings(reason, self);
+    dumpFds(reason, self);
+    dumpContainerProcesses(reason);
+}
+
+} // namespace GPUDebugProc
