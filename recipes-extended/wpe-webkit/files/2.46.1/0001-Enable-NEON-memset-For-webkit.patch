+endif ()
diff --git a/Source/WTF/wtf/arm/memset_wpewebkit.S b/Source/WTF/wtf/arm/memset_wpewebkit.S
new file mode 100644
index 000000000000..3df1e9bc1c96
--- /dev/null
+++ b/Source/WTF/wtf/arm/memset_wpewebkit.S
@@ -0,0 +1,151 @@
