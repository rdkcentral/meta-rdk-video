     auto* context = scriptExecutionContext();
     if (!context)
         return;
+   // auto& eventType = event->type();
+    //bool isMSEEvent = eventType == "updatestart" || eventType == "update" || eventType == "updateend" || eventType == "sourceopen" || eventType == "sourceclose";
