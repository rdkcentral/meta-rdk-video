+WebGLTexture* WebGLRenderingContextBase::textureBoundTo(GCGLenum target) const
+{
+    if (m_activeTextureUnit >= m_textureUnits.size())
+        return nullptr;
+    auto& unit = m_textureUnits[m_activeTextureUnit];
+    switch (target) {
+    case GraphicsContextGL::TEXTURE_2D:
+        return unit.texture2DBinding.get();
+    case GraphicsContextGL::TEXTURE_CUBE_MAP:
+    case GraphicsContextGL::TEXTURE_CUBE_MAP_POSITIVE_X:
+    case GraphicsContextGL::TEXTURE_CUBE_MAP_NEGATIVE_X:
+    case GraphicsContextGL::TEXTURE_CUBE_MAP_POSITIVE_Y:
+    case GraphicsContextGL::TEXTURE_CUBE_MAP_NEGATIVE_Y:
+    case GraphicsContextGL::TEXTURE_CUBE_MAP_POSITIVE_Z:
+    case GraphicsContextGL::TEXTURE_CUBE_MAP_NEGATIVE_Z:
+        return unit.textureCubeMapBinding.get();
+    case GraphicsContextGL::TEXTURE_3D:
+        return unit.texture3DBinding.get();
+    case GraphicsContextGL::TEXTURE_2D_ARRAY:
+        return unit.texture2DArrayBinding.get();
+    default:
+        return nullptr;
+    }
+}
+
+void WebGLRenderingContextBase::trackTextureImage(const char* operation, GCGLenum target, GCGLint level, GCGLenum internalformat, GCGLenum format, GCGLenum type, GCGLsizei width, GCGLsizei height, GCGLsizei depth)
+{
+    RefPtr<WebGLTexture> texture = textureBoundTo(target);
+    if (!texture || !texture->object())
+        return;
+    WebGLResourceTracker::singleton().textureImageDefined(resourceTrackerKey(), texture->object(), target, level, width, height, depth,
+        WebGLResourceTracker::bytesPerPixel(internalformat, format, type), 0, operation);
+}
+
+void WebGLRenderingContextBase::trackCompressedTextureImage(const char* operation, GCGLenum target, GCGLint level, GCGLsizei width, GCGLsizei height, GCGLsizei depth, GCGLsizei imageSize)
+{
+    RefPtr<WebGLTexture> texture = textureBoundTo(target);
+    if (!texture || !texture->object())
+        return;
+    WebGLResourceTracker::singleton().textureImageDefined(resourceTrackerKey(), texture->object(), target, level, width, height, depth, 0, std::max<GCGLsizei>(imageSize, 0), operation);
+}
+
+void WebGLRenderingContextBase::trackRenderbufferStorage(const char* operation, GCGLenum internalformat, GCGLsizei samples, GCGLsizei width, GCGLsizei height)
+{
+    if (!m_renderbufferBinding || !m_renderbufferBinding->object())
+        return;
+    WebGLResourceTracker::singleton().renderbufferStorageDefined(resourceTrackerKey(), m_renderbufferBinding->object(), internalformat, samples, width, height, operation);
+}
+
+void WebGLRenderingContextBase::trackMipmapsGenerated(GCGLenum target)
+{
+    RefPtr<WebGLTexture> texture = textureBoundTo(target);
+    if (!texture || !texture->object())
+        return;
+
+    GCGLint baseLevel = 0;
+    GCGLint maxLevel = 1000;
+    if (isWebGL2()) {
+        baseLevel = m_context->getTexParameteri(target, GraphicsContextGL::TEXTURE_BASE_LEVEL);
+        maxLevel = m_context->getTexParameteri(target, GraphicsContextGL::TEXTURE_MAX_LEVEL);
+    }
+    WebGLResourceTracker::singleton().textureMipmapsGenerated(resourceTrackerKey(), texture->object(), target, baseLevel, maxLevel);
+}
+
+#if !USE(ANGLE)
+bool WebGLRenderingContextBase::hasPendingOutOfMemoryError()
+{
+    // There's no way to inspect the GL errors without consuming them, so take all the pending
+    // ones and synthesize them again, in the same order, for the application to get them.
+    Vector<GCGLenum, 4> errors;
+    // Set an arbitrary limit here to avoid a hang if a driver never clears the error.
+    for (unsigned i = 0; i < 100; ++i) {
+        GCGLenum error = m_context->getError();
+        if (error == GraphicsContextGL::NO_ERROR)
+            break;
+        errors.append(error);
+    }
+    for (auto error : errors)
+        m_context->synthesizeGLError(error);
+    return errors.contains(GraphicsContextGL::OUT_OF_MEMORY);
+}
+
+static double bytesToMiB(uint64_t bytes)
+{
+    return static_cast<double>(bytes) / (1024.0 * 1024.0);
+}
+
+bool WebGLRenderingContextBase::checkTextureOutOfMemory(bool outOfMemoryWasPending, const char* operation, GCGLenum target, GCGLint level, GCGLsizei levels, GCGLenum internalFormat, GCGLsizei width, GCGLsizei height, GCGLsizei depth, GCGLsizei samples, uint64_t requestedBytes)
+{
+    // GL keeps a single instance of each error, so an OUT_OF_MEMORY that was already pending
+    // before the call hides a new one.
+    if (outOfMemoryWasPending || !hasPendingOutOfMemoryError())
+        return false;
+
+    RefPtr<WebGLTexture> texture = textureBoundTo(target);
+    auto totals = WebGLResourceTracker::singleton().totals();
+    uint64_t total = totals.textureBytes + totals.renderbufferBytes + totals.bufferBytes;
+    WTFLogAlways("[WebGL] [%.6f] OUT OF MEMORY: %s failed for texture %u (target 0x%04X, level %d, "
+        "levels %d, size %dx%dx%d, samples %d, internal format 0x%04X, requested ~%" PRIu64 " bytes, %.2f MiB) => allocated so far: "
