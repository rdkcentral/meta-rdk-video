+static constexpr GCGLenum BGRA8_EXT = 0x93A1;
+static constexpr GCGLenum DEPTH_COMPONENT32_OES = 0x81A7;
+
+static const char* webGLResourceTypeName(unsigned type)
+{
+    switch (type) {
+    case 0:
+        return "texture";
+    case 1:
+        return "renderbuffer";
+    case 2:
+        return "buffer";
+    }
+    return "unknown";
+}
+
+static double webGLResourceBytesToMiB(uint64_t bytes)
+{
+    return static_cast<double>(bytes) / (1024.0 * 1024.0);
+}
+
+WebGLResourceTracker& WebGLResourceTracker::singleton()
+{
+    static NeverDestroyed<WebGLResourceTracker> tracker;
+    return tracker;
+}
+
+unsigned WebGLResourceTracker::bytesPerPixel(GCGLenum internalFormat, GCGLenum format, GCGLenum type)
+{
+    // Sized internal formats.
+    switch (internalFormat) {
+    case GL::R8:
+    case GL::R8_SNORM:
+    case GL::R8UI:
+    case GL::R8I:
+    case GL::STENCIL_INDEX8:
+        return 1;
+    case GL::R16F:
+    case GL::R16UI:
+    case GL::R16I:
+    case GL::R16_EXT:
+    case GL::R16_SNORM_EXT:
+    case GL::RG8:
+    case GL::RG8_SNORM:
+    case GL::RG8UI:
+    case GL::RG8I:
+    case GL::RGB565:
+    case GL::RGBA4:
+    case GL::RGB5_A1:
+    case GL::DEPTH_COMPONENT16:
+        return 2;
+    case GL::RGB8:
+    case GL::SRGB8:
+    case GL::RGB8_SNORM:
+    case GL::RGB8UI:
+    case GL::RGB8I:
+        return 3;
+    case GL::R32F:
+    case GL::R32UI:
+    case GL::R32I:
+    case GL::RG16F:
+    case GL::RG16UI:
+    case GL::RG16I:
+    case GL::RG16_EXT:
+    case GL::RG16_SNORM_EXT:
+    case GL::RGBA8:
+    case GL::SRGB8_ALPHA8:
+    case GL::RGBA8_SNORM:
+    case GL::RGBA8UI:
+    case GL::RGBA8I:
+    case BGRA8_EXT:
+    case GL::RGB10_A2:
+    case GL::RGB10_A2UI:
+    case GL::R11F_G11F_B10F:
+    case GL::RGB9_E5:
+    case GL::DEPTH_COMPONENT24:
+    case DEPTH_COMPONENT32_OES:
+    case GL::DEPTH_COMPONENT32F:
+    case GL::DEPTH24_STENCIL8:
+        return 4;
+    case GL::RGB16F:
+    case GL::RGB16UI:
+    case GL::RGB16I:
+    case GL::RGB16_EXT:
+    case GL::RGB16_SNORM_EXT:
+        return 6;
+    case GL::RG32F:
+    case GL::RG32UI:
+    case GL::RG32I:
+    case GL::RGBA16F:
+    case GL::RGBA16UI:
+    case GL::RGBA16I:
+    case GL::RGBA16_EXT:
+    case GL::RGBA16_SNORM_EXT:
+    case GL::DEPTH32F_STENCIL8:
+        return 8;
+    case GL::RGB32F:
+    case GL::RGB32UI:
+    case GL::RGB32I:
+        return 12;
+    case GL::RGBA32F:
+    case GL::RGBA32UI:
+    case GL::RGBA32I:
+        return 16;
+    default:
+        break;
+    }
+
+    // Unsized internal formats: the size depends on format and type.
+    switch (type) {
+    case GL::UNSIGNED_SHORT_5_6_5:
+    case GL::UNSIGNED_SHORT_4_4_4_4:
+    case GL::UNSIGNED_SHORT_5_5_5_1:
+        return 2;
+    case GL::UNSIGNED_INT_2_10_10_10_REV:
+    case GL::UNSIGNED_INT_10F_11F_11F_REV:
+    case GL::UNSIGNED_INT_5_9_9_9_REV:
+    case GL::UNSIGNED_INT_24_8:
+        return 4;
+    case GL::FLOAT_32_UNSIGNED_INT_24_8_REV:
+        return 8;
+    default:
+        break;
+    }
+
+    unsigned typeSize = 0;
+    switch (type) {
+    case GL::BYTE:
+    case GL::UNSIGNED_BYTE:
+        typeSize = 1;
+        break;
+    case GL::SHORT:
+    case GL::UNSIGNED_SHORT:
+    case GL::HALF_FLOAT:
+    case GL::HALF_FLOAT_OES:
+        typeSize = 2;
+        break;
+    case GL::INT:
+    case GL::UNSIGNED_INT:
+    case GL::FLOAT:
+        typeSize = 4;
+        break;
+    default:
+        return 0;
+    }
+
+    switch (format) {
+    case GL::RED:
+    case GL::RED_INTEGER:
+    case GL::ALPHA:
+    case GL::LUMINANCE:
+        return typeSize;
+    case GL::DEPTH_COMPONENT:
+        return typeSize;
+    case GL::RG:
+    case GL::RG_INTEGER:
+    case GL::LUMINANCE_ALPHA:
+        return 2 * typeSize;
+    case GL::RGB:
+    case GL::RGB_INTEGER:
+    case GL::SRGB_EXT:
+        return 3 * typeSize;
+    case GL::RGBA:
+    case GL::RGBA_INTEGER:
+    case GL::BGRA_EXT:
+    case GL::SRGB_ALPHA_EXT:
+        return 4 * typeSize;
+    default:
+        return 0;
+    }
+}
+
+uint64_t WebGLResourceTracker::compressedImageSize(GCGLenum internalFormat, GCGLsizei width, GCGLsizei height, GCGLsizei depth)
+{
+    unsigned blockWidth = 4;
+    unsigned blockHeight = 4;
+    unsigned blockBytes = 0;
+
+    switch (internalFormat) {
+    case GL::COMPRESSED_RGB_S3TC_DXT1_EXT:
+    case GL::COMPRESSED_RGBA_S3TC_DXT1_EXT:
+    case GL::COMPRESSED_SRGB_S3TC_DXT1_EXT:
+    case GL::COMPRESSED_SRGB_ALPHA_S3TC_DXT1_EXT:
+    case GL::ETC1_RGB8_OES:
+    case GL::COMPRESSED_R11_EAC:
+    case GL::COMPRESSED_SIGNED_R11_EAC:
+    case GL::COMPRESSED_RGB8_ETC2:
+    case GL::COMPRESSED_SRGB8_ETC2:
+    case GL::COMPRESSED_RGB8_PUNCHTHROUGH_ALPHA1_ETC2:
+    case GL::COMPRESSED_SRGB8_PUNCHTHROUGH_ALPHA1_ETC2:
+    case GL::COMPRESSED_RED_RGTC1_EXT:
+    case GL::COMPRESSED_SIGNED_RED_RGTC1_EXT:
+    case GL::COMPRESSED_ATC_RGB_AMD:
+        blockBytes = 8;
+        break;
+    case GL::COMPRESSED_RGBA_S3TC_DXT3_EXT:
+    case GL::COMPRESSED_RGBA_S3TC_DXT5_EXT:
+    case GL::COMPRESSED_SRGB_ALPHA_S3TC_DXT3_EXT:
+    case GL::COMPRESSED_SRGB_ALPHA_S3TC_DXT5_EXT:
+    case GL::COMPRESSED_RG11_EAC:
+    case GL::COMPRESSED_SIGNED_RG11_EAC:
+    case GL::COMPRESSED_RGBA8_ETC2_EAC:
+    case GL::COMPRESSED_SRGB8_ALPHA8_ETC2_EAC:
+    case GL::COMPRESSED_RED_GREEN_RGTC2_EXT:
+    case GL::COMPRESSED_SIGNED_RED_GREEN_RGTC2_EXT:
+    case GL::COMPRESSED_RGBA_BPTC_UNORM_EXT:
+    case GL::COMPRESSED_SRGB_ALPHA_BPTC_UNORM_EXT:
+    case GL::COMPRESSED_RGB_BPTC_SIGNED_FLOAT_EXT:
+    case GL::COMPRESSED_RGB_BPTC_UNSIGNED_FLOAT_EXT:
+    case GL::COMPRESSED_ATC_RGBA_EXPLICIT_ALPHA_AMD:
+    case GL::COMPRESSED_ATC_RGBA_INTERPOLATED_ALPHA_AMD:
+        blockBytes = 16;
+        break;
+    case GL::COMPRESSED_RGB_PVRTC_4BPPV1_IMG:
+    case GL::COMPRESSED_RGBA_PVRTC_4BPPV1_IMG:
+        if (width <= 0 || height <= 0 || depth <= 0)
+            return 0;
+        return (static_cast<uint64_t>(std::max(width, 8)) * std::max(height, 8) * 4 + 7) / 8 * depth;
+    case GL::COMPRESSED_RGB_PVRTC_2BPPV1_IMG:
+    case GL::COMPRESSED_RGBA_PVRTC_2BPPV1_IMG:
+        if (width <= 0 || height <= 0 || depth <= 0)
+            return 0;
+        return (static_cast<uint64_t>(std::max(width, 16)) * std::max(height, 8) * 2 + 7) / 8 * depth;
+    default: {
+        // ASTC: all the block sizes use 16 bytes per block.
+        static constexpr std::pair<unsigned, unsigned> astcBlocks[] = {
+            { 4, 4 }, { 5, 4 }, { 5, 5 }, { 6, 5 }, { 6, 6 }, { 8, 5 }, { 8, 6 },
+            { 8, 8 }, { 10, 5 }, { 10, 6 }, { 10, 8 }, { 10, 10 }, { 12, 10 }, { 12, 12 }
+        };
+        std::optional<unsigned> astcIndex;
+        if (internalFormat >= GL::COMPRESSED_RGBA_ASTC_4x4_KHR && internalFormat <= GL::COMPRESSED_RGBA_ASTC_12x12_KHR)
+            astcIndex = internalFormat - GL::COMPRESSED_RGBA_ASTC_4x4_KHR;
+        else if (internalFormat >= GL::COMPRESSED_SRGB8_ALPHA8_ASTC_4x4_KHR && internalFormat <= GL::COMPRESSED_SRGB8_ALPHA8_ASTC_12x12_KHR)
+            astcIndex = internalFormat - GL::COMPRESSED_SRGB8_ALPHA8_ASTC_4x4_KHR;
+        if (!astcIndex || *astcIndex >= std::size(astcBlocks))
+            return 0;
+        blockWidth = astcBlocks[*astcIndex].first;
+        blockHeight = astcBlocks[*astcIndex].second;
+        blockBytes = 16;
+        break;
+    }
+    }
+
+    if (width <= 0 || height <= 0 || depth <= 0)
+        return 0;
+    uint64_t blocksWide = (static_cast<uint64_t>(width) + blockWidth - 1) / blockWidth;
+    uint64_t blocksHigh = (static_cast<uint64_t>(height) + blockHeight - 1) / blockHeight;
+    return blocksWide * blocksHigh * blockBytes * depth;
+}
+
+WebGLResourceTracker::Resource& WebGLResourceTracker::ensureResource(const void* context, GCGLuint name, Type type)
+{
+    auto it = m_resources.find({ context, name });
+    if (it != m_resources.end() && it->second.type == type)
+        return it->second;
+
+    // Resource not created through the tracked paths: start tracking it now.
+    WTFLogAlways("[WebGL] [%.6f] WARNING: %s %u (context %p) was not tracked, tracking it from now on", elapsedSeconds(), webGLResourceTypeName(static_cast<unsigned>(type)), name, context);
+    addResource(context, name, type, "implicitly created");
+    return m_resources.find({ context, name })->second;
+}
+
+double WebGLResourceTracker::elapsedSeconds()
+{
+    // Initialized (thread-safely) on the first call.
+    static const MonotonicTime startTime = MonotonicTime::now();
+    return (MonotonicTime::now() - startTime).seconds();
+}
+
+void WebGLResourceTracker::addResource(const void* context, GCGLuint name, Type type, const char* operation)
+{
+    if (!name)
+        return;
+
+    auto result = m_resources.emplace(ObjectKey { context, name }, Resource(type));
+    if (!result.second) {
+        // Name reused without a delete (shouldn't happen): drop the old entry first.
+        removeResource(context, name, result.first->second.type, "replaced");
+        result = m_resources.emplace(ObjectKey { context, name }, Resource(type));
+    }
+
+    m_totals[static_cast<size_t>(type)].count++;
+    logTotals(operation, type, name, 0);
+}
+
+void WebGLResourceTracker::removeResource(const void* context, GCGLuint name, Type type, const char* operation)
+{
+    if (!name)
+        return;
+
+    auto it = m_resources.find({ context, name });
+    if (it == m_resources.end() || it->second.type != type)
+        return;
+
+    auto& totals = m_totals[static_cast<size_t>(type)];
+    uint64_t bytes = it->second.bytes;
+    totals.count--;
+    totals.bytes -= bytes;
+    m_resources.erase(it);
+    logTotals(operation, type, name, -static_cast<int64_t>(bytes));
+}
+
+void WebGLResourceTracker::setResourceBytes(Resource& resource, uint64_t bytes)
+{
+    auto& totals = m_totals[static_cast<size_t>(resource.type)];
+    totals.bytes = totals.bytes - resource.bytes + bytes;
+    resource.bytes = bytes;
+}
+
+void WebGLResourceTracker::setTextureImage(Resource& resource, GCGLenum target, GCGLint level, const ImageInfo& image)
+{
+    auto& slot = resource.images[{ target, level }];
+    uint64_t newBytes = resource.bytes - slot.bytes + image.bytes;
+    slot = image;
+    setResourceBytes(resource, newBytes);
+}
+
+void WebGLResourceTracker::logChange(const char* operation, Type type, GCGLuint name, uint64_t previousBytes, uint64_t newBytes)
+{
+    // Only log when the totals change.
+    if (previousBytes != newBytes)
+        logTotals(operation, type, name, static_cast<int64_t>(newBytes) - static_cast<int64_t>(previousBytes));
+}
+
+void WebGLResourceTracker::logTotals(const char* operation, Type type, GCGLuint name, int64_t deltaBytes)
+{
+    const auto& textures = m_totals[static_cast<size_t>(Type::Texture)];
+    const auto& renderbuffers = m_totals[static_cast<size_t>(Type::Renderbuffer)];
+    const auto& buffers = m_totals[static_cast<size_t>(Type::Buffer)];
+    uint64_t total = textures.bytes + renderbuffers.bytes + buffers.bytes;
+
+    WTFLogAlways("[WebGL] [%.6f] %s %s %u (%+" PRId64 " bytes) => "
+        "textures: %" PRIu64 " (%" PRIu64 " bytes, %.2f MiB) | "
+        "renderbuffers: %" PRIu64 " (%" PRIu64 " bytes, %.2f MiB) | "
+        "buffers: %" PRIu64 " (%" PRIu64 " bytes, %.2f MiB) | "
+        "total: %" PRIu64 " bytes (%.2f MiB)",
+        elapsedSeconds(), operation, webGLResourceTypeName(static_cast<unsigned>(type)), name, deltaBytes,
+        textures.count, textures.bytes, webGLResourceBytesToMiB(textures.bytes),
+        renderbuffers.count, renderbuffers.bytes, webGLResourceBytesToMiB(renderbuffers.bytes),
+        buffers.count, buffers.bytes, webGLResourceBytesToMiB(buffers.bytes),
+        total, webGLResourceBytesToMiB(total));
+}
+
+WebGLResourceTracker::TotalsSnapshot WebGLResourceTracker::totals()
+{
+    Locker locker { m_lock };
+    const auto& textures = m_totals[static_cast<size_t>(Type::Texture)];
+    const auto& renderbuffers = m_totals[static_cast<size_t>(Type::Renderbuffer)];
+    const auto& buffers = m_totals[static_cast<size_t>(Type::Buffer)];
+    return { textures.count, textures.bytes, renderbuffers.count, renderbuffers.bytes, buffers.count, buffers.bytes };
+}
+
+void WebGLResourceTracker::textureCreated(const void* context, GCGLuint texture)
+{
+    Locker locker { m_lock };
+    addResource(context, texture, Type::Texture, "created");
+}
+
+void WebGLResourceTracker::textureDeleted(const void* context, GCGLuint texture)
+{
+    Locker locker { m_lock };
+    removeResource(context, texture, Type::Texture, "deleted");
+}
+
+void WebGLResourceTracker::textureImageDefined(const void* context, GCGLuint texture, GCGLenum target, GCGLint level, GCGLsizei width, GCGLsizei height, GCGLsizei depth, unsigned bytesPerPixel, uint64_t compressedSize, const char* operation)
+{
+    if (!texture)
+        return;
+
+    Locker locker { m_lock };
+    auto& resource = ensureResource(context, texture, Type::Texture);
+
+    ImageInfo image { width, height, depth, bytesPerPixel, 0 };
+    if (width > 0 && height > 0 && depth > 0)
+        image.bytes = bytesPerPixel ? static_cast<uint64_t>(bytesPerPixel) * width * height * depth : compressedSize;
+
+    uint64_t previousBytes = resource.bytes;
+    setTextureImage(resource, target, level, image);
+    logChange(operation, Type::Texture, texture, previousBytes, resource.bytes);
+}
+
+void WebGLResourceTracker::textureStorageDefined(const void* context, GCGLuint texture, GCGLenum target, GCGLsizei levels, GCGLenum internalFormat, GCGLsizei width, GCGLsizei height, GCGLsizei depth, const char* operation)
+{
+    if (!texture)
+        return;
+
+    Locker locker { m_lock };
+    auto& resource = ensureResource(context, texture, Type::Texture);
+    resource.immutable = true;
+
+    uint64_t previousBytes = resource.bytes;
+    resource.images.clear();
+    setResourceBytes(resource, 0);
+
+    unsigned pixelBytes = bytesPerPixel(internalFormat, GL::NONE, GL::NONE);
+    bool isArray = target == GL::TEXTURE_2D_ARRAY;
+    for (GCGLsizei level = 0; level < levels; ++level) {
+        ImageInfo image {
+            std::max(width >> level, 1),
+            std::max(height >> level, 1),
+            isArray ? depth : std::max(depth >> level, 1),
+            pixelBytes,
+            0
+        };
+        image.bytes = pixelBytes ? static_cast<uint64_t>(pixelBytes) * image.width * image.height * image.depth : compressedImageSize(internalFormat, image.width, image.height, image.depth);
+        if (target == GL::TEXTURE_CUBE_MAP) {
+            for (GCGLenum face = GL::TEXTURE_CUBE_MAP_POSITIVE_X; face <= GL::TEXTURE_CUBE_MAP_NEGATIVE_Z; ++face)
+                setTextureImage(resource, face, level, image);
+        } else
+            setTextureImage(resource, target, level, image);
+    }
+
+    logChange(operation, Type::Texture, texture, previousBytes, resource.bytes);
+}
+
+void WebGLResourceTracker::textureMipmapsGenerated(const void* context, GCGLuint texture, GCGLenum target, GCGLint baseLevel, GCGLint maxLevel)
+{
+    if (!texture)
+        return;
+
+    Locker locker { m_lock };
+    auto& resource = ensureResource(context, texture, Type::Texture);
+    // Immutable textures already have all their levels allocated.
+    if (resource.immutable)
+        return;
+
+    GCGLenum baseTarget = target == GL::TEXTURE_CUBE_MAP ? GL::TEXTURE_CUBE_MAP_POSITIVE_X : target;
+    auto baseIt = resource.images.find({ baseTarget, baseLevel });
+    if (baseIt == resource.images.end())
+        return;
+    ImageInfo base = baseIt->second;
+    if (!base.bytes || !base.bytesPerPixel)
+        return;
+
+    // Last level of the mip chain: floor(log2(max dimension)) levels above the base one.
+    int maxDimension = std::max(base.width, base.height);
+    if (target == GL::TEXTURE_3D)
+        maxDimension = std::max(maxDimension, base.depth);
+    GCGLint lastLevel = std::min<GCGLint>(baseLevel + static_cast<GCGLint>(std::log2(maxDimension)), maxLevel);
+    if (lastLevel <= baseLevel)
+        return;
+
+    uint64_t previousBytes = resource.bytes;
+    bool isArray = target == GL::TEXTURE_2D_ARRAY;
+    for (GCGLint level = baseLevel + 1; level <= lastLevel; ++level) {
+        int relativeLevel = level - baseLevel;
+        ImageInfo image {
+            std::max(base.width >> relativeLevel, 1),
+            std::max(base.height >> relativeLevel, 1),
+            isArray ? base.depth : std::max(base.depth >> relativeLevel, 1),
+            base.bytesPerPixel,
+            0
+        };
+        image.bytes = static_cast<uint64_t>(image.bytesPerPixel) * image.width * image.height * image.depth;
+        if (target == GL::TEXTURE_CUBE_MAP) {
+            for (GCGLenum face = GL::TEXTURE_CUBE_MAP_POSITIVE_X; face <= GL::TEXTURE_CUBE_MAP_NEGATIVE_Z; ++face)
+                setTextureImage(resource, face, level, image);
+        } else
+            setTextureImage(resource, target, level, image);
+    }
+
+    logChange("generateMipmap", Type::Texture, texture, previousBytes, resource.bytes);
+}
+
+void WebGLResourceTracker::renderbufferCreated(const void* context, GCGLuint renderbuffer)
+{
+    Locker locker { m_lock };
+    addResource(context, renderbuffer, Type::Renderbuffer, "created");
+}
+
+void WebGLResourceTracker::renderbufferDeleted(const void* context, GCGLuint renderbuffer)
+{
+    Locker locker { m_lock };
+    removeResource(context, renderbuffer, Type::Renderbuffer, "deleted");
+}
+
+void WebGLResourceTracker::renderbufferStorageDefined(const void* context, GCGLuint renderbuffer, GCGLenum internalFormat, GCGLsizei samples, GCGLsizei width, GCGLsizei height, const char* operation)
+{
+    if (!renderbuffer)
+        return;
+
+    Locker locker { m_lock };
+    auto& resource = ensureResource(context, renderbuffer, Type::Renderbuffer);
+    uint64_t bytes = 0;
+    if (width > 0 && height > 0)
+        bytes = static_cast<uint64_t>(bytesPerPixel(internalFormat, GL::NONE, GL::NONE)) * width * height * std::max<GCGLsizei>(samples, 1);
+
+    uint64_t previousBytes = resource.bytes;
+    setResourceBytes(resource, bytes);
+    logChange(operation, Type::Renderbuffer, renderbuffer, previousBytes, resource.bytes);
+}
+
+void WebGLResourceTracker::bufferCreated(const void* context, GCGLuint buffer)
+{
+    Locker locker { m_lock };
+    addResource(context, buffer, Type::Buffer, "created");
+}
+
+void WebGLResourceTracker::bufferDeleted(const void* context, GCGLuint buffer)
+{
+    Locker locker { m_lock };
+    removeResource(context, buffer, Type::Buffer, "deleted");
+}
+
+void WebGLResourceTracker::bufferDataDefined(const void* context, GCGLuint buffer, uint64_t size, const char* operation)
+{
+    if (!buffer)
+        return;
+
+    Locker locker { m_lock };
+    auto& resource = ensureResource(context, buffer, Type::Buffer);
+    uint64_t previousBytes = resource.bytes;
+    setResourceBytes(resource, size);
+    logChange(operation, Type::Buffer, buffer, previousBytes, resource.bytes);
+}
+
+void WebGLResourceTracker::contextObjectsDetached(const void* context)
+{
+    Locker locker { m_lock };
+
+    Vector<std::pair<GCGLuint, Type>> remaining;
+    uint64_t remainingBytes = 0;
+    for (auto& [key, resource] : m_resources) {
+        if (key.first != context)
+            continue;
+        remaining.append({ key.second, resource.type });
+        remainingBytes += resource.bytes;
+    }
+
+    if (remaining.isEmpty())
+        return;
+
+    // The GraphicsContextGL is going away (or being replaced) while some of the tracked objects
+    // haven't been deleted through the WebGL API. They are released together with the GL context.
+    WTFLogAlways("[WebGL] [%.6f] context %p detached %zu resources (%" PRIu64 " bytes) without deleting them, dropping them", elapsedSeconds(), context, remaining.size(), remainingBytes);
+    for (auto& [name, type] : remaining)
+        removeResource(context, name, type, "detached without delete");
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(WEBGL)
