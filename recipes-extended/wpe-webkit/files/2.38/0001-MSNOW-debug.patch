From 93f0060291941d5abea6271c632a8994edc17b94 Mon Sep 17 00:00:00 2001
From: Krishna Priya Kanagaraj <krishnapriya_kanagaraj@comcast.com>
Date: Wed, 12 Aug 2026 07:59:38 +0000
Subject: [PATCH] MSNOW debug

---
 .../gstreamer/mse/MediaSourcePrivateGStreamer.cpp         | 8 ++++++++
 .../graphics/gstreamer/mse/WebKitMediaSourceGStreamer.cpp | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/Source/WebCore/platform/graphics/gstreamer/mse/MediaSourcePrivateGStreamer.cpp b/Source/WebCore/platform/graphics/gstreamer/mse/MediaSourcePrivateGStreamer.cpp
index 17529f2ef8c2..d8af4be7dd56 100644
--- a/Source/WebCore/platform/graphics/gstreamer/mse/MediaSourcePrivateGStreamer.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/mse/MediaSourcePrivateGStreamer.cpp
@@ -154,6 +154,14 @@ void MediaSourcePrivateGStreamer::unmarkEndOfStream()
     GST_DEBUG_OBJECT(m_playerPrivate.pipeline(), "Un-marking EOS");
     m_playerPrivate.setEosWithNoBuffers(false);
     m_isEnded = false;
+
+    if (m_hasAllTracks) {
+	printf("%d %s KKP\n",__LINE__,__PRETTY_FUNCTION__);fflush(stdout);
+        for (auto& sourceBuffer : m_sourceBuffers) {
+            for (auto& track : sourceBuffer->tracks())
+                sourceBuffer->flush(track->trackId());
+        }
+    }
 }
 
 MediaPlayer::ReadyState MediaSourcePrivateGStreamer::readyState() const
diff --git a/Source/WebCore/platform/graphics/gstreamer/mse/WebKitMediaSourceGStreamer.cpp b/Source/WebCore/platform/graphics/gstreamer/mse/WebKitMediaSourceGStreamer.cpp
index e6ad6bd96686..d42f99060305 100644
--- a/Source/WebCore/platform/graphics/gstreamer/mse/WebKitMediaSourceGStreamer.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/mse/WebKitMediaSourceGStreamer.cpp
@@ -815,12 +815,20 @@ static void webKitMediaSrcLoop(void* userData)
     } else if (GST_IS_EVENT(object.get())) {
         // EOS events and other enqueued events are also sent unlocked so they can react to flushes if necessary.
         GRefPtr<GstEvent> event = GRefPtr<GstEvent>(GST_EVENT(object.leakRef()));
+        bool isEOS = GST_EVENT_TYPE(event.get()) == GST_EVENT_EOS;
 
         streamingMembers.unlockEarly();
         GST_DEBUG_OBJECT(pad, "Pushing event downstream: %" GST_PTR_FORMAT, event.get());
         bool eventHandled = gst_pad_push_event(pad, GRefPtr<GstEvent>(event).leakRef());
         if (!eventHandled)
             GST_DEBUG_OBJECT(pad, "Pushed event was not handled: %" GST_PTR_FORMAT, event.get());
+
+        if (isEOS) {
+	printf("%d %s KKP\n",__LINE__,__PRETTY_FUNCTION__);fflush(stdout);
+            DataMutexLocker streamingMembersAfterEOS { stream->streamingMembersDataMutex };
+            GST_ERROR_OBJECT(pad, "KKP: EOS pushed, resetting wasStreamStartSent to allow re-sending STREAM_START.");
+            streamingMembersAfterEOS->wasStreamStartSent = false;
+        }
     } else
         ASSERT_NOT_REACHED();
 }
