diff --git a/Source/cmake/FindManette.cmake b/Source/cmake/FindManette.cmake
index 5c1551c1feb6..b2ffd16641b9 100644
--- a/Source/cmake/FindManette.cmake
+++ b/Source/cmake/FindManette.cmake
@@ -53,7 +53,13 @@ This will define the following variables in your project:
 #]=======================================================================]
 
 find_package(PkgConfig QUIET)
-pkg_check_modules(PC_MANETTE QUIET manette-0.2)
+
+# Try manette-1 first (libmanette 1.0), fall back to manette-0.2
+pkg_check_modules(PC_MANETTE QUIET manette-1)
+if (NOT PC_MANETTE_FOUND)
+    pkg_check_modules(PC_MANETTE QUIET manette-0.2)
+endif ()
+
 set(Manette_COMPILE_OPTIONS ${PC_MANETTE_CFLAGS_OTHER})
 set(Manette_VERSION ${PC_MANETTE_VERSION})
 
@@ -64,7 +70,7 @@ find_path(Manette_INCLUDE_DIR
 )
 
 find_library(Manette_LIBRARY
-    NAMES ${Manette_NAMES} manette-0.2
+    NAMES ${Manette_NAMES} manette-1 manette-0.2
     HINTS ${PC_MANETTE_LIBDIR}
           ${PC_MANETTE_LIBRARY_DIRS}
 )
diff --git a/Source/cmake/OptionsWPE.cmake b/Source/cmake/OptionsWPE.cmake
index ca69c411b044..e094ec2989cc 100644
--- a/Source/cmake/OptionsWPE.cmake
+++ b/Source/cmake/OptionsWPE.cmake
@@ -236,6 +236,19 @@ if (ENABLE_GAMEPAD AND (NOT (WPE_VERSION VERSION_GREATER_EQUAL 1.16.2)))
     message(FATAL_ERROR "libwpe>=1.16.2 is required for ENABLE_GAMEPAD")
 endif ()
 
+option(USE_MANETTE_GAMEPAD_PROVIDER "Use ManetteGamepadProvider (direct libmanette) instead of libwpe gamepad" ON)
+
+if (ENABLE_GAMEPAD)
+    if (USE_MANETTE_GAMEPAD_PROVIDER)
+        find_package(Manette)
+        if (NOT Manette_FOUND)
+            message(FATAL_ERROR "libmanette is required for USE_MANETTE_GAMEPAD_PROVIDER")
+        endif ()
+        SET_AND_EXPOSE_TO_BUILD(USE_MANETTE TRUE)
+        SET_AND_EXPOSE_TO_BUILD(USE_MANETTE_GAMEPAD_PROVIDER TRUE)
+    endif ()
+endif ()
+
 if (ENABLE_SPEECH_SYNTHESIS)
     if (USE_FLITE)
         if (USE_TTS_CLIENT)
