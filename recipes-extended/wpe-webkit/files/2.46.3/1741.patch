--- a/Source/WebCore/platform/gamepad/manette/ManetteGamepad.h
+++ b/Source/WebCore/platform/gamepad/manette/ManetteGamepad.h
@@ -31,6 +31,12 @@
 #include "PlatformGamepad.h"
 
 #include <libmanette.h>
