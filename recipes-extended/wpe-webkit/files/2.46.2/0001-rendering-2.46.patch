diff --git a/Source/WebCore/platform/graphics/GPUDebugNexus.h b/Source/WebCore/platform/graphics/GPUDebugNexus.h
new file mode 100644
index 000000000000..d7868c6ee16b
--- /dev/null
+++ b/Source/WebCore/platform/graphics/GPUDebugNexus.h
@@ -0,0 +1,164 @@
+// [GPUDEBUG] Debug-only Broadcom Nexus heap probe. Self-contained so it can be included from WebCore and ANGLE.
+// Nexus is resolved with dlopen/dlsym, so no build-system or link changes are needed.
+// Set GPUDBG_NO_NEXUS=1 in the WPEWebProcess environment to disable all Nexus queries.
+#pragma once
+
+#include <dlfcn.h>
+#include <mutex>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+namespace GPUDebugNexus {
+
+static constexpr int kMaxHeaps = 32;
+
+// Mirrors the leading members of NEXUS_ClientConfiguration (nexus_base_types_client.h); oversized buffer absorbs the rest.
+struct ClientConfigurationPrefix {
+    int mode;
+    void* heap[kMaxHeaps];
+};
+
+// Mirrors NEXUS_MemoryStatus (nexus_memory.h); identical in the 2.38 and 2.46 sysroots.
+struct MemoryStatus {
+    unsigned memoryType;
+    unsigned heapType;
+    unsigned memcIndex;
+    uint64_t offset;
+    void* addr;
+    unsigned size;
+    unsigned free;
+    unsigned alignment;
+    unsigned numAllocs;
+    unsigned numFreeBlocks;
+    unsigned largestFreeBlock;
+    unsigned highWatermark;
+    int memoryOsType;
+};
+
+struct Snapshot {
+    int count { 0 };
+    void* heap[kMaxHeaps] { };
+    MemoryStatus status[kMaxHeaps] { };
+};
+
+typedef void (*GetClientConfigurationFn)(void*);
+typedef unsigned (*HeapGetStatusFn)(void*, void*);
+
+struct State {
+    std::mutex lock;
+    bool initialized { false };
+    bool disabled { false };
+    GetClientConfigurationFn getClientConfiguration { nullptr };
+    HeapGetStatusFn heapGetStatus { nullptr };
+};
+
+static inline State& state()
+{
+    static State s;
+    return s;
+}
+
+static inline bool ensureInitialized(State& s)
+{
+    if (s.initialized)
+        return !s.disabled;
+    if (getenv("GPUDBG_NO_NEXUS")) {
+        s.initialized = true;
+        s.disabled = true;
+        fprintf(stderr, "[GPUDEBUG] NEXUS probe disabled by GPUDBG_NO_NEXUS\n");
+        return false;
+    }
+    // Only probe when the GPU driver already loaded (and joined) Nexus in this process; retry on later calls.
+    void* handle = dlopen("libnexus.so", RTLD_LAZY | RTLD_NOLOAD);
+    if (!handle) {
+        static bool reported = false;
+        if (!reported) {
+            reported = true;
+            fprintf(stderr, "[GPUDEBUG] NEXUS probe: libnexus.so not loaded yet in pid=%d, will retry\n", getpid());
+        }
+        return false;
+    }
+    s.initialized = true;
+    s.getClientConfiguration = reinterpret_cast<GetClientConfigurationFn>(dlsym(handle, "NEXUS_Platform_GetClientConfiguration"));
+    s.heapGetStatus = reinterpret_cast<HeapGetStatusFn>(dlsym(handle, "NEXUS_Heap_GetStatus"));
+    if (!s.getClientConfiguration || !s.heapGetStatus) {
+        s.disabled = true;
+        fprintf(stderr, "[GPUDEBUG] NEXUS probe unavailable getClientConfiguration=%p heapGetStatus=%p\n",
+            reinterpret_cast<void*>(s.getClientConfiguration), reinterpret_cast<void*>(s.heapGetStatus));
+        return false;
+    }
+    fprintf(stderr, "[GPUDEBUG] NEXUS probe ready pid=%d\n", getpid());
+    return true;
+}
+
+static inline bool takeSnapshot(Snapshot& out)
+{
+    State& s = state();
+    std::lock_guard<std::mutex> guard(s.lock);
+    if (!ensureInitialized(s))
+        return false;
+
+    alignas(8) static unsigned char configBuffer[16384];
+    memset(configBuffer, 0, sizeof(configBuffer));
+    s.getClientConfiguration(configBuffer);
+    auto* config = reinterpret_cast<ClientConfigurationPrefix*>(configBuffer);
+
+    out.count = 0;
+    for (int i = 0; i < kMaxHeaps; ++i) {
+        void* heap = config->heap[i];
+        if (!heap)
+            continue;
+        alignas(8) unsigned char statusBuffer[1024];
+        memset(statusBuffer, 0, sizeof(statusBuffer));
+        if (s.heapGetStatus(heap, statusBuffer))
+            continue;
+        out.heap[out.count] = heap;
+        memcpy(&out.status[out.count], statusBuffer, sizeof(MemoryStatus));
+        out.count++;
+    }
+    return out.count > 0;
+}
+
+// heapType bits: 0x1 MAIN, 0x2 PICTURE_BUFFERS, 0x10 GRAPHICS, 0x20 SECONDARY_GRAPHICS, 0x80 SECURE_GRAPHICS.
+static inline void dump(const char* reason)
+{
+    Snapshot snap;
+    if (!takeSnapshot(snap)) {
+        static unsigned s_unavailableReports = 0;
+        if (s_unavailableReports++ < 3)
+            fprintf(stderr, "[GPUDEBUG] NEXUS_HEAPS reason=%s unavailable (no heaps visible to pid=%d)\n", reason, getpid());
+        return;
+    }
+    for (int i = 0; i < snap.count; ++i) {
+        const MemoryStatus& st = snap.status[i];
+        fprintf(stderr, "[GPUDEBUG] NEXUS_HEAP reason=%s pid=%d idx=%d heap=%p heapType=0x%x memType=0x%x memc=%u sizeKB=%u freeKB=%u usedKB=%u largestFreeKB=%u numAllocs=%u freeBlocks=%u highWatermarkKB=%u\n",
+            reason, getpid(), i, snap.heap[i], st.heapType, st.memoryType, st.memcIndex, st.size / 1024, st.free / 1024,
+            (st.size - st.free) / 1024, st.largestFreeBlock / 1024, st.numAllocs, st.numFreeBlocks, st.highWatermark / 1024);
+    }
+}
+
+// Prints only heaps whose free size changed between two snapshots; used to measure the real cost of one allocation.
+static inline void dumpDelta(const char* tag, const Snapshot& before, const Snapshot& after, unsigned long long estimatedBytes)
+{
+    bool printed = false;
+    for (int i = 0; i < after.count; ++i) {
+        for (int j = 0; j < before.count; ++j) {
+            if (before.heap[j] != after.heap[i])
+                continue;
+            long long delta = static_cast<long long>(before.status[j].free) - static_cast<long long>(after.status[i].free);
+            int allocDelta = static_cast<int>(after.status[i].numAllocs) - static_cast<int>(before.status[j].numAllocs);
+            if (delta || allocDelta) {
+                fprintf(stderr, "[GPUDEBUG] NEXUS_DELTA %s estBytes=%llu heapType=0x%x usedDeltaBytes=%lld allocDelta=%d freeKB=%u largestFreeKB=%u\n",
+                    tag, estimatedBytes, after.status[i].heapType, delta, allocDelta, after.status[i].free / 1024, after.status[i].largestFreeBlock / 1024);
+                printed = true;
+            }
+        }
+    }
+    if (!printed)
+        fprintf(stderr, "[GPUDEBUG] NEXUS_DELTA %s estBytes=%llu usedDeltaBytes=0 (no heap change; driver may sub-allocate from a pool)\n", tag, estimatedBytes);
+}
+
+} // namespace GPUDebugNexus
