From 887f4d7232a7b80753e3d9e88c1ef86308e13247 Mon Sep 17 00:00:00 2001
From: Andrzej Surdej <Andrzej_Surdej@comcast.com>
Date: Tue, 13 Oct 2026 16:32:41 +0200
Subject: [PATCH] [MSE][GStreamer] Flush GStreamer pipeline when media element
 is detached from DOM

HTMLMediaElement::removedFromAncestor() now flushes the GStreamer
pipeline (and suspends the MSE source's data flow) instead of leaving
the MediaPlayer fully active while detached.
This releases media buffers and secure video memory for pages that detach
video elements without resetting or destroying them.
---
 Source/WebCore/html/HTMLMediaElement.cpp      | 25 +++++++++++-
 Source/WebCore/html/HTMLMediaElement.h        |  1 +
 .../WebCore/platform/graphics/MediaPlayer.cpp |  8 ++++
 .../WebCore/platform/graphics/MediaPlayer.h   |  3 ++
 .../platform/graphics/MediaPlayerPrivate.h    |  2 +
 .../mse/MediaPlayerPrivateGStreamerMSE.cpp    | 18 +++++++++
 .../mse/MediaPlayerPrivateGStreamerMSE.h      |  2 +
 .../mse/WebKitMediaSourceGStreamer.cpp        | 38 ++++++++++++++++---
 .../mse/WebKitMediaSourceGStreamer.h          |  3 ++
 9 files changed, 93 insertions(+), 7 deletions(-)

diff --git a/Source/WebCore/html/HTMLMediaElement.cpp b/Source/WebCore/html/HTMLMediaElement.cpp
index efaf5b8d3c52..ff91752befc5 100644
--- a/Source/WebCore/html/HTMLMediaElement.cpp
+++ b/Source/WebCore/html/HTMLMediaElement.cpp
@@ -1063,6 +1063,16 @@ void HTMLMediaElement::didFinishInsertingNode()
     if (m_inActiveDocument && m_networkState == NETWORK_EMPTY && !attributeWithoutSynchronization(srcAttr).isEmpty())
         prepareForLoad();
 
+#if PLATFORM(WPE)
+    if (RefPtr player = m_player) {
+        if (m_playerFlushedWhileDetached) {
+            m_playerFlushedWhileDetached = false;
+            seekInternal(currentMediaTime());
+            player->resumePlayback();
+        }
+    }
+#endif // PLATFORM(WPE)
+
     visibilityAdjustmentStateDidChange();
 
     if (!m_explicitlyMuted) {
@@ -1141,8 +1151,17 @@ void HTMLMediaElement::removedFromAncestor(RemovalType removalType, ContainerNod
     if (removalType.disconnectedFromDocument) {
         // Pause asynchronously to let the operation that removed us finish, in case we get inserted back into a document.
         queueTaskKeepingObjectAlive(*this, TaskSource::MediaElement, [this] {
-            if (!isContextStopped())
-                pauseAfterDetachedTask();
+            if (isContextStopped())
+                return;
+            pauseAfterDetachedTask();
+
+#if PLATFORM(WPE)
+            if (RefPtr player = m_player) {
+                ALWAYS_LOG(LOGIDENTIFIER, "Flushing media player pipeline of detached element");
+                player->flushPipelineAndSuspendPlayback();
+                m_playerFlushedWhileDetached = true;
+            }
+#endif // PLATFORM(WPE)
         });
     }
 
@@ -6634,6 +6653,7 @@ void HTMLMediaElement::clearMediaPlayer()
         player->invalidate();
         m_player = nullptr;
     }
+    m_playerFlushedWhileDetached = false;
     schedulePlaybackControlsManagerUpdate();
 
     stopPeriodicTimers();
@@ -7904,6 +7924,7 @@ void HTMLMediaElement::createMediaPlayer() WTF_IGNORES_THREAD_SAFETY_ANALYSIS
 #endif
 
     m_networkErrorOccured = false;
+    m_playerFlushedWhileDetached = false;
     m_lastContentTypeUsed.reset();
     if (RefPtr player = std::exchange(m_player, { })) {
         // The sniffer completionHandler would have taken a reference to the old MediaPlayer.
diff --git a/Source/WebCore/html/HTMLMediaElement.h b/Source/WebCore/html/HTMLMediaElement.h
index 417b3666ac87..0d5b2caa49d2 100644
--- a/Source/WebCore/html/HTMLMediaElement.h
+++ b/Source/WebCore/html/HTMLMediaElement.h
@@ -1417,6 +1417,7 @@ private:
 #endif
 
     bool m_isChangingReadyStateWhileSuspended { false };
+    bool m_playerFlushedWhileDetached { false };
     Atomic<unsigned> m_remainingReadyStateChangedAttempts;
 
     std::unique_ptr<PausableIntervalTimer> m_watchtimeTimer;
diff --git a/Source/WebCore/platform/graphics/MediaPlayer.cpp b/Source/WebCore/platform/graphics/MediaPlayer.cpp
index 9ef8f5ae9636..399b5099353a 100644
--- a/Source/WebCore/platform/graphics/MediaPlayer.cpp
+++ b/Source/WebCore/platform/graphics/MediaPlayer.cpp
@@ -1126,6 +1126,14 @@ void MediaPlayer::setPageIsSuspended(bool suspended)
     m_private->setPageIsSuspended(suspended);
 }
 
+void MediaPlayer::flushPipelineAndSuspendPlayback()
+{
+    m_private->flushPipelineAndSuspendPlayback();
+}
+void MediaPlayer::resumePlayback()
+{
+    m_private->resumePlayback();
+}
 void MediaPlayer::setVisibleForCanvas(bool visible)
 {
     if (visible == m_visibleForCanvas)
diff --git a/Source/WebCore/platform/graphics/MediaPlayer.h b/Source/WebCore/platform/graphics/MediaPlayer.h
