+++ b/Source/WebCore/platform/graphics/MediaPlayerPrivate.h
@@ -105,6 +105,8 @@ public:
     virtual void play() = 0;
     virtual void pause() = 0;
     virtual void setBufferingPolicy(MediaPlayer::BufferingPolicy) { }
