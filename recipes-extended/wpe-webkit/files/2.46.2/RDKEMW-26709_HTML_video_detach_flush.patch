     virtual bool supportsPictureInPicture() const { return false; }
     virtual bool supportsFullscreen() const { return false; }
diff --git a/Source/WebCore/platform/graphics/gstreamer/mse/MediaPlayerPrivateGStreamerMSE.cpp b/Source/WebCore/platform/graphics/gstreamer/mse/MediaPlayerPrivateGStreamerMSE.cpp
index 958059298618..b54193122236 100644
--- a/Source/WebCore/platform/graphics/gstreamer/mse/MediaPlayerPrivateGStreamerMSE.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/mse/MediaPlayerPrivateGStreamerMSE.cpp
@@ -536,6 +536,24 @@ void MediaPlayerPrivateGStreamerMSE::setInitialVideoSize(const FloatSize& videoS
     m_videoSize = videoSize;
 }
 
+void MediaPlayerPrivateGStreamerMSE::flushPipelineAndSuspendPlayback()
+{
+    if (!m_source)
+        return;
+
+    GST_INFO_OBJECT(pipeline(), "Suspending and flushing all WebKitMediaSrc streams");
+    webKitMediaSrcFlushAndSuspend(webKitMediaSrc());
+}
+
+void MediaPlayerPrivateGStreamerMSE::resumePlayback()
+{
+    if (!m_source)
+        return;
+
+    GST_INFO_OBJECT(pipeline(), "Resuming all WebKitMediaSrc streams");
+    webKitMediaSrcResume(webKitMediaSrc());
+}
+
 void MediaPlayerPrivateGStreamerMSE::startSource(const Vector<RefPtr<MediaSourceTrackGStreamer>>& tracks)
 {
     m_tracks = filterOutRepeatingTracks(tracks);
diff --git a/Source/WebCore/platform/graphics/gstreamer/mse/MediaPlayerPrivateGStreamerMSE.h b/Source/WebCore/platform/graphics/gstreamer/mse/MediaPlayerPrivateGStreamerMSE.h
index 45b12dd68aca..4d945614a3e4 100644
--- a/Source/WebCore/platform/graphics/gstreamer/mse/MediaPlayerPrivateGStreamerMSE.h
+++ b/Source/WebCore/platform/graphics/gstreamer/mse/MediaPlayerPrivateGStreamerMSE.h
@@ -67,6 +67,8 @@ public:
     MediaTime maxTimeSeekable() const override;
     bool timeIsProgressing() const override;
     void notifyActiveSourceBuffersChanged() final;
