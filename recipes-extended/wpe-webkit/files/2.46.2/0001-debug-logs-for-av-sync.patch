 void VCMTiming::SetJitterDelay(TimeDelta jitter_delay) {
   MutexLock lock(&mutex_);
   if (jitter_delay != jitter_delay_) {
+    TimeDelta old_jitter_delay = jitter_delay_;
+    TimeDelta old_current_delay = current_delay_;
     jitter_delay_ = jitter_delay;
-    // When in initial state, set current delay to minimum delay.
     if (current_delay_.IsZero()) {
       current_delay_ = jitter_delay_;
     }
+    RTC_LOG(LS_INFO) << "WebRTCAVSync timing SetJitterDelay old_jitter_delay="
+                     << old_jitter_delay << " new_jitter_delay="
+                     << jitter_delay_ << " old_current_delay="
+                     << old_current_delay << " current_delay="
+                     << current_delay_;
   }
