   if (acm_receiver_.SetMinimumDelay(delay_ms) != 0) {
+    RTC_LOG(LS_INFO) << "WebRTCAVSync audio-sync SetMinimumPlayoutDelay requested_delay_ms="
+                     << requested_delay_ms << " applied_delay_ms=" << delay_ms
+                     << " success=0";
     RTC_DLOG(LS_ERROR)
         << "SetMinimumPlayoutDelay() failed to set min playout delay";
     return false;
   }
+  RTC_LOG(LS_INFO) << "WebRTCAVSync audio-sync SetMinimumPlayoutDelay requested_delay_ms="
+                   << requested_delay_ms << " applied_delay_ms=" << delay_ms
+                   << " success=1";
   return true;
 }
 
