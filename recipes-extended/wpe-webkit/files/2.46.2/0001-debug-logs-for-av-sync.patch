     CheckDelaysValid(min_playout_delay_, max_playout_delay);
     max_playout_delay_ = max_playout_delay;
+    RTC_LOG(LS_INFO) << "WebRTCAVSync timing set_max_playout_delay old="
+                     << old_max_playout_delay << " new=" << max_playout_delay_
+                     << " min=" << min_playout_delay_;
   }
