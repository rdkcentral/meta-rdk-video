From: Petar Tijanic <petartijanic01@gmail.com>
Date: Wed, 21 Oct 2026 16:00:00 +0200
Subject: [PATCH] comcast - RDKEMW-25325 - [GStreamer] Use Content-Range when
 Content-Length is missing

A server answering a progressive media request with 206 and Content-Range
but without Content-Length (body sent chunked) made WebKit treat the
resource as a live stream: webkitwebsrc reported size 0 / not seekable and
MediaPlayerPrivateGStreamer set m_isLiveStream from the missing
Content-Length. seekable() was then empty and HTMLMediaElement ignored every
seek ("ignored seek to ...").

Take the instance length from Content-Range in both places when
Content-Length is absent.

Fixes HbbTV org.hbbtv_HTML52090 (seek to an unbuffered position must issue
a Range request covering it).

Test: repro server answering 206 + Content-Range, chunked, no
Content-Length; seek to 1200 s now issues Range: bytes=<~14 MB>-.
---
diff --git a/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp b/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
index aef5694..29daf2a 100644
--- a/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/MediaPlayerPrivateGStreamer.cpp
@@ -46,6 +46,7 @@
 #include "MediaPlayer.h"
 #include "NotImplemented.h"
 #include "OriginAccessPatterns.h"
+#include "ParsedContentRange.h"
 #include "SecurityOrigin.h"
 #include "TextCombinerGStreamer.h"
 #include "TextSinkGStreamer.h"
@@ -2268,6 +2269,15 @@ void MediaPlayerPrivateGStreamer::handleMessage(GstMessage* message)
                     }
                 } else
                     contentLength = *contentLengthFromResponse;
+                if (!contentLength) {
+                    // A 206 without Content-Length (for instance sent chunked) still carries the full
+                    // resource size in Content-Range, so it is not a live stream.
+                    if (auto contentRangeValue = gstStructureGetString(responseHeaders.get(), httpHeaderNameString(HTTPHeaderName::ContentRange))) {
+                        ParsedContentRange contentRange(contentRangeValue.toString());
+                        if (contentRange.isValid() && contentRange.instanceLength() != ParsedContentRange::unknownLength)
+                            contentLength = contentRange.instanceLength();
+                    }
+                }
                 if (!isRangeRequest) {
                     m_isLiveStream = !contentLength;
                     GST_INFO_OBJECT(pipeline(), "%s stream detected", m_isLiveStream.value_or(false) ? "Live" : "Non-live");
diff --git a/Source/WebCore/platform/graphics/gstreamer/WebKitWebSourceGStreamer.cpp b/Source/WebCore/platform/graphics/gstreamer/WebKitWebSourceGStreamer.cpp
index 484f025..6cc5435 100644
--- a/Source/WebCore/platform/graphics/gstreamer/WebKitWebSourceGStreamer.cpp
+++ b/Source/WebCore/platform/graphics/gstreamer/WebKitWebSourceGStreamer.cpp
@@ -1042,7 +1042,18 @@ void CachedResourceStreamingClient::responseReceived(PlatformMediaResource&, con
         && (contentLength = parseInteger<uint64_t>(response.httpHeaderField(HTTPHeaderName::ContentLength))))
         length = contentLength.value();
 
-    if (length > 0 && members->requestedPosition && response.httpStatusCode() == 206)
+    // A 206 without Content-Length (for instance sent chunked) still carries the full resource size in
+    // Content-Range: bytes first-last/total. Use it, otherwise the resource is treated as unseekable.
+    bool isLengthFromContentRange = false;
+    if (!length && response.httpStatusCode() == 206 && !response.httpHeaderFields().contains(HTTPHeaderName::ContentEncoding)) {
+        const auto& contentRange = response.contentRange();
+        if (contentRange.isValid() && contentRange.instanceLength() != ParsedContentRange::unknownLength) {
+            length = contentRange.instanceLength();
+            isLengthFromContentRange = true;
+        }
+    }
+
+    if (length > 0 && members->requestedPosition && response.httpStatusCode() == 206 && !isLengthFromContentRange)
         length += members->requestedPosition;
 
     GUniquePtr<GstStructure> httpHeaders(gst_structure_new_empty("http-headers"));
