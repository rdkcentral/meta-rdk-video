diff --git a/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/TraceMarkerGL.h b/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/TraceMarkerGL.h
new file mode 100644
index 000000000000..9c1e5d1b8538
--- /dev/null
+++ b/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/TraceMarkerGL.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define TRACE_MARKER_PATH "/sys/kernel/debug/tracing/trace_marker"
+
+namespace rx {
+
+inline void __trace_mark__(const char* message)
+{
+    int fd = open(TRACE_MARKER_PATH, O_WRONLY);
+    if (fd < 0) {
+        perror("Failed to open trace_marker");
+        return;
+    }
+    size_t messageLength = strlen(message);
+    ssize_t bytesWritten = write(fd, message, messageLength);
+    if (bytesWritten < 0)
+        perror("Failed to write to trace_marker");
+    else if (static_cast<size_t>(bytesWritten) < messageLength)
+        fprintf(stderr, "Partial write to trace_marker: expected %zu bytes, wrote %zd bytes\n", messageLength, bytesWritten);
+    if (close(fd) < 0)
+        perror("Failed to close trace_marker");
+}
+
+class ScopedTraceMarker
+{
+  public:
+    ScopedTraceMarker(const char* operation, const char* details)
+        : m_operation(operation)
+        , m_details(details)
+    {
+        char message[384];
+        snprintf(message, sizeof(message), "WPE_GPU|ANGLE_TEXTURE|BEGIN|op=%s %s", m_operation, m_details);
+        __trace_mark__(message);
+    }
+
+    ~ScopedTraceMarker()
+    {
+        char message[384];
+        snprintf(message, sizeof(message), "WPE_GPU|ANGLE_TEXTURE|END|op=%s result=%s %s",
+                 m_operation, m_succeeded ? "success" : "error_or_early_return", m_details);
+        __trace_mark__(message);
+    }
+
+    void markSucceeded() { m_succeeded = true; }
+
+  private:
+    const char* m_operation;
+    const char* m_details;
+    bool m_succeeded { false };
+};
+
+} // namespace rx
