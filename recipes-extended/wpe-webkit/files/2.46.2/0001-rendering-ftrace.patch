+#endif
+    snprintf(mIdentity, sizeof(mIdentity),
+             "pid=%d op=%s owner=%p texture=%u width=%d height=%d format=0x%x level=%zu",
+             traceProcessId(), operation, owner, texture, width, height, format, level);
+    char marker[480];
+    snprintf(marker, sizeof(marker), "WPE_GPU|ANGLE_INTERNAL_TEXTURE_BEGIN|%s", mIdentity);
+    writeTraceMarker(marker);
+}
+
+ScopedInternalTextureTrace::~ScopedInternalTextureTrace()
+{
+    long long gpuAfter = -1;
+#if defined(__linux__)
+    gpuAfter = readTraceGpuUsage();
+#endif
+    const bool measured = mGpuBefore >= 0 && gpuAfter >= 0;
+    char marker[768];
+    snprintf(marker, sizeof(marker),
+             "WPE_GPU|ANGLE_INTERNAL_TEXTURE_END|%s result=%s gpu_measured=%d gpu_before_bytes=%lld gpu_after_bytes=%lld gpu_delta_bytes=%lld",
+             mIdentity, mSucceeded ? "success" : "error_or_early_return", measured,
+             mGpuBefore, gpuAfter, measured ? gpuAfter - mGpuBefore : 0);
+    writeTraceMarker(marker);
+}
