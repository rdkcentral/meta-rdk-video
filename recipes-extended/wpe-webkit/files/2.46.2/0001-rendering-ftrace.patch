 {
+#if defined(__linux__)
+constexpr char kTraceMarkerPath[] = "/sys/kernel/debug/tracing/trace_marker";
+std::atomic<bool> gTraceMarkerUnavailable { false };
+
+int traceProcessId()
+{
+    return static_cast<int>(getpid());
+}
+
+long long readTraceGpuUsage()
+{
+    const char *enabled = getenv("GPUDBG_TRACE_MEMORY");
+    const char *path = getenv("WPE_POLL_MAX_MEMORY_GPU_FILE");
+    if (!enabled || strcmp(enabled, "1") || !path || !*path)
+        return -1;
+    FILE *file = fopen(path, "r");
+    if (!file)
+        return -1;
+    long long bytes = -1;
+    if (fscanf(file, "%lld", &bytes) != 1)
+        bytes = -1;
+    fclose(file);
+    return bytes;
+}
+
+void writeTraceMarker(const char *message)
+{
+    if (gTraceMarkerUnavailable.load(std::memory_order_relaxed))
+        return;
+
+    const int fd = open(kTraceMarkerPath, O_WRONLY | O_CLOEXEC);
+    if (fd < 0)
+    {
+        bool expected = false;
+        if (gTraceMarkerUnavailable.compare_exchange_strong(expected, true))
+            fprintf(stderr, "[GPUDEBUG] FTRACE_MARKER_UNAVAILABLE path=%s errno=%d\n", kTraceMarkerPath, errno);
+        return;
+    }
+
+    char line[1024];
+    const int length = snprintf(line, sizeof(line), "%s\n", message);
+    bool failed = length <= 0 || static_cast<size_t>(length) >= sizeof(line);
+    size_t written = 0;
+    while (!failed && written < static_cast<size_t>(length))
+    {
+        const ssize_t result = write(fd, line + written, static_cast<size_t>(length) - written);
+        if (result < 0 && errno == EINTR)
+            continue;
+        if (result <= 0)
+        {
+            failed = true;
+            break;
+        }
+        written += static_cast<size_t>(result);
+    }
+    const int writeError = failed ? errno : 0;
+    close(fd);
+    if (failed)
+    {
+        bool expected = false;
+        if (gTraceMarkerUnavailable.compare_exchange_strong(expected, true))
+            fprintf(stderr, "[GPUDEBUG] FTRACE_MARKER_WRITE_FAILED path=%s errno=%d\n", kTraceMarkerPath, writeError);
+    }
+}
+
+class ScopedTextureTraceMarker
+{
+  public:
+    ScopedTextureTraceMarker(const char *operation,
+                             const void *object,
+                             GLuint texture,
+                             GLenum target,
+                             size_t level,
+                             GLenum format,
+                             const gl::Extents &size,
+                             GLuint pixelBytes,
+                             bool hasPixels)
+    {
+        mGpuBefore = readTraceGpuUsage();
+        const unsigned long long estimatedBytes =
+            static_cast<unsigned long long>(std::max(size.width, 0)) *
+            std::max(size.height, 0) * std::max(size.depth, 0) * pixelBytes;
+        snprintf(mIdentity, sizeof(mIdentity),
+                 "pid=%d op=%s object=%p texture=%u target=0x%x level=%zu format=0x%x dims=%dx%dx%d pixel_bytes=%u estimated_bytes=%llu has_pixels=%d",
+                 getpid(), operation, object, texture, target, level, format, size.width, size.height,
+                 size.depth, pixelBytes, estimatedBytes, hasPixels);
+        char marker[480];
+        snprintf(marker, sizeof(marker), "WPE_GPU|ANGLE_TEXTURE_BEGIN|%s", mIdentity);
+        writeTraceMarker(marker);
+    }
+
+    ~ScopedTextureTraceMarker()
+    {
+        const long long gpuAfter = readTraceGpuUsage();
+        const bool measured = mGpuBefore >= 0 && gpuAfter >= 0;
+        char marker[768];
+        snprintf(marker, sizeof(marker), "WPE_GPU|ANGLE_TEXTURE_END|%s result=%s gpu_measured=%d gpu_before_bytes=%lld gpu_after_bytes=%lld gpu_delta_bytes=%lld",
+                 mIdentity, mSucceeded ? "success" : "error_or_early_return", measured,
+                 mGpuBefore, gpuAfter, measured ? gpuAfter - mGpuBefore : 0);
+        writeTraceMarker(marker);
+    }
+
+    void markSucceeded() { mSucceeded = true; }
+
+  private:
+    char mIdentity[384] { };
+    bool mSucceeded { false };
+    long long mGpuBefore { -1 };
+};
+#else
+void writeTraceMarker(const char *)
+{}
+
+int traceProcessId()
+{
+    return 0;
+}
+
+class ScopedTextureTraceMarker
+{
+  public:
+    ScopedTextureTraceMarker(const char *, const void *, GLuint, GLenum, size_t, GLenum,
+                             const gl::Extents &, GLuint, bool)
+    {}
+    void markSucceeded() {}
+};
+#endif
