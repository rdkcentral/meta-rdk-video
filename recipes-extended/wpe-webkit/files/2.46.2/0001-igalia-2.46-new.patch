+// Bytes per pixel of a native internal format. Unsized native formats are resolved with the
+// native format and type, which is what the driver will use to choose the storage.
+GLuint NativeBytesPerPixel(GLenum nativeInternalFormat, GLenum nativeFormat, GLenum nativeType)
+{
+    const gl::InternalFormat &sizedInfo = gl::GetSizedInternalFormatInfo(nativeInternalFormat);
+    if (sizedInfo.internalFormat != GL_NONE)
+        return sizedInfo.pixelBytes;
+    return gl::GetInternalFormatInfo(nativeFormat, nativeType).pixelBytes;
+}
+
+// Logs how a texture definition requested through the frontend is translated to the native
+// driver call. The translation can differ between ES 2 (WebGL 1) and ES 3 (WebGL 2) contexts
+// (unsized vs sized internal formats, texStorage vs texImage, emulated formats...), which can
+// make the driver allocate a different amount of memory for the same content.
+void LogNativeTextureDefinition(const gl::Context *context,
+                                const char *operation,
+                                GLuint nativeId,
+                                gl::TextureType textureType,
+                                GLenum target,
+                                size_t level,
+                                size_t levels,
+                                GLenum requestedInternalFormat,
+                                GLenum requestedFormat,
+                                GLenum requestedType,
+                                const gl::InternalFormat &frontendInfo,
+                                GLenum nativeInternalFormat,
+                                GLenum nativeFormat,
+                                GLenum nativeType,
+                                const gl::Extents &size,
+                                const LevelInfoGL *levelInfo)
+{
+    const GLuint nativeBpp = NativeBytesPerPixel(nativeInternalFormat, nativeFormat, nativeType);
+    const bool sizedNative =
+        gl::GetSizedInternalFormatInfo(nativeInternalFormat).internalFormat != GL_NONE;
+    const int64_t faces = textureType == gl::TextureType::CubeMap && target == GL_TEXTURE_CUBE_MAP ? 6 : 1;
+    // Estimate of the native allocation, including all the levels for texStorage calls.
+    int64_t nativeBytes = 0;
+    for (size_t i = 0; i < std::max<size_t>(levels, 1); ++i)
+    {
+        const int64_t w = std::max(size.width >> i, 1);
+        const int64_t h = std::max(size.height >> i, 1);
+        const int64_t d = textureType == gl::TextureType::_3D ? std::max(size.depth >> i, 1)
+                                                              : size.depth;
+        nativeBytes += w * h * d * nativeBpp * faces;
+    }
+
+    fprintf(stderr,
+            "[ANGLE] [%.6f] NATIVE TEXTURE context %p (ES %d.%d, WebGL version %d): %s native texture %u "
+            "target 0x%04X level %zu levels %zu size %dx%dx%d | requested internalformat 0x%04X "
+            "format 0x%04X type 0x%04X -> frontend sized format 0x%04X (%u bytes/pixel, %s) -> "
+            "native internalformat 0x%04X (%s) format 0x%04X type 0x%04X (%u bytes/pixel)%s | "
+            "estimated native bytes %" PRId64 " (%.2f MiB)",
+            angle_resource_tracker_timestamp_seconds(), static_cast<const void *>(context),
+            context->getClientVersion().major, context->getClientVersion().minor,
+            (context->isWebGL() ? (context->getClientVersion().major >= 3 ? 2 : 1) : 0), operation, nativeId, target, level, levels, size.width,
+            size.height, size.depth, requestedInternalFormat, requestedFormat, requestedType,
+            frontendInfo.sizedInternalFormat, frontendInfo.pixelBytes,
+            frontendInfo.sized ? "sized" : "unsized", nativeInternalFormat,
+            sizedNative ? "sized" : "UNSIZED", nativeFormat, nativeType, nativeBpp,
+            nativeBpp != frontendInfo.pixelBytes ? " [NATIVE SIZE DIFFERS FROM FRONTEND]" : "",
+            nativeBytes, static_cast<double>(nativeBytes) / (1024.0 * 1024.0));
+    if (levelInfo)
+    {
+        fprintf(stderr, " | workarounds: depthStencil %d, luma %d (0x%04X), emulatedAlpha %d",
+                levelInfo->depthStencilWorkaround, levelInfo->lumaWorkaround.enabled,
+                levelInfo->lumaWorkaround.workaroundFormat, levelInfo->emulatedAlphaChannel);
+    }
+    fprintf(stderr, "\n");
+    fflush(stderr);
+}
+
+#ifndef GL_TEXTURE_COMPRESSED_IMAGE_SIZE
+#    define GL_TEXTURE_COMPRESSED_IMAGE_SIZE 0x86A0
+#endif
+#ifndef GL_TEXTURE_COMPRESSED
+#    define GL_TEXTURE_COMPRESSED 0x86A1
+#endif
