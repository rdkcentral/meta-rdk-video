+
+// ResourceMemoryTracker.h: Process-wide bookkeeping of the frontend GL objects that can consume
+// a significant amount of (video) memory: textures, renderbuffers and buffers. Every time one of
+// those objects is created, destroyed or its storage changes, the current totals are written to
+// stderr, so they can be compared with the ones tracked by the WebGL implementation on top of
+// ANGLE (WebCore::WebGLResourceTracker).
+//
+// The memory figures are estimations based on the frontend state (image descs, renderbuffer
+// size and format, buffer size); backends may allocate more (padding, emulated formats, etc).
+
+#ifndef LIBANGLE_RESOURCEMEMORYTRACKER_H_
+#define LIBANGLE_RESOURCEMEMORYTRACKER_H_
+
+#include "angle_gl.h"
+
+#include <cstdint>
+
+namespace gl
+{
+struct ImageDesc;
+struct Format;
+
+enum class TrackedResourceType
+{
+    // Textures created by the application (the ones WebGL knows about).
+    Texture,
+    Renderbuffer,
+    Buffer,
+    // Textures that ANGLE creates for itself: the per-context default (zero) textures and the
+    // incomplete textures used when sampling from incomplete textures.
+    InternalTexture,
+
+    EnumCount,
+};
+
+class ResourceMemoryTracker final
+{
+  public:
+    static void OnCreated(TrackedResourceType type, GLuint id);
+    static void OnDestroyed(TrackedResourceType type, GLuint id, int64_t remainingBytes);
+    static void OnMemoryChanged(TrackedResourceType type, GLuint id, int64_t deltaBytes);
+
+    // Logs that allocating the storage of a texture failed with GL_OUT_OF_MEMORY, either in the
+    // driver or in ANGLE itself. |requestedBytes| is the estimated size of what was requested.
+    static void OnTextureOutOfMemory(GLuint id,
+                                     const char *operation,
+                                     GLenum target,
+                                     GLint level,
+                                     GLsizei levels,
+                                     GLenum internalFormat,
+                                     GLsizei width,
+                                     GLsizei height,
+                                     GLsizei depth,
+                                     GLsizei samples,
+                                     int64_t requestedBytes);
+
+    static TrackedResourceType TextureTypeForId(GLuint id);
+
+    static int64_t EstimateImageMemory(const ImageDesc &desc);
+    static int64_t EstimateRenderbufferMemory(GLsizei width,
+                                              GLsizei height,
+                                              const Format &format,
+                                              GLsizei samples);
+};
+
+}  // namespace gl
+
+// Seconds elapsed since the first call to this function, which therefore returns 0 the first
+// time. It is the clock used for the log timestamps of both this tracker and WebKit's
+// WebGLResourceTracker, so the first event received by either of them sets time 0. Thread safe.
+extern "C" double angle_resource_tracker_timestamp_seconds();
+
