+void Context::logConfigurationForMemoryDebugging(const egl::Display *display) const
+{
+    const double timestamp = angle_resource_tracker_timestamp_seconds();
+    const Caps &caps       = getCaps();
+    const Extensions &ext  = getExtensions();
+    const gl::Version maxDisplayVersion =
+        display ? display->getMaxSupportedESVersion() : gl::Version(0, 0);
+
+    fprintf(stderr,
+            "[ANGLE] [%.6f] CONFIG context %p: client ES %d.%d (display max ES %d.%d), "
+            "webgl compatibility: %d, robust resource init: %d, robust access: %d, "
+            "bind generates resource: %d, client arrays: %d, extensions requestable: %d, "
+            "renderer: \"%s\", version: \"%s\"\n",
+            timestamp, static_cast<const void *>(this), getClientVersion().major,
+            getClientVersion().minor, maxDisplayVersion.major, maxDisplayVersion.minor,
+            isWebGL(), isRobustResourceInitEnabled(), isRobustnessEnabled(),
+            mState.isBindGeneratesResourceEnabled(), mState.areClientArraysEnabled(),
+            mExtensionsEnabled ? 0 : 1, mRendererString ? mRendererString : "",
+            mVersionString ? mVersionString : "");
+
+    // Limits that depend on the client version and determine how big the resources the
+    // application can allocate are.
+    fprintf(stderr,
+            "[ANGLE] [%.6f] CONFIG context %p caps: max2DTextureSize %d, max3DTextureSize %d, "
+            "maxArrayTextureLayers %d, maxCubeMapTextureSize %d, maxRenderbufferSize %d, "
+            "maxSamples %d, maxColorAttachments %d, maxDrawBuffers %d\n",
+            timestamp, static_cast<const void *>(this), caps.max2DTextureSize,
+            caps.max3DTextureSize, caps.maxArrayTextureLayers, caps.maxCubeMapTextureSize,
+            caps.maxRenderbufferSize, caps.maxSamples, caps.maxColorAttachments,
+            caps.maxDrawBuffers);
+
+    // Extensions that change how textures and renderbuffers are stored.
+    fprintf(stderr,
+            "[ANGLE] [%.6f] CONFIG context %p storage related extensions: textureStorageEXT %d, "
+            "rgb8Rgba8OES %d, textureFormatBGRA8888EXT %d, packedDepthStencilOES %d, "
+            "depth24OES %d, framebufferMultisampleANGLE %d, multisampledRenderToTextureEXT %d, "
+            "textureFloatOES %d, textureHalfFloatOES %d, colorBufferFloatEXT %d, "
+            "colorBufferHalfFloatEXT %d, robustResourceInitializationANGLE %d\n",
+            timestamp, static_cast<const void *>(this), ext.textureStorageEXT, ext.rgb8Rgba8OES,
+            ext.textureFormatBGRA8888EXT, ext.packedDepthStencilOES, ext.depth24OES,
+            ext.framebufferMultisampleANGLE, ext.multisampledRenderToTextureEXT,
+            ext.textureFloatOES, ext.textureHalfFloatOES, ext.colorBufferFloatEXT,
+            ext.colorBufferHalfFloatEXT, ext.robustResourceInitializationANGLE);
+
+    fprintf(stderr, "[ANGLE] [%.6f] CONFIG context %p enabled extensions (%zu):",
+            timestamp, static_cast<const void *>(this), mExtensionStrings.size());
+    for (const char *extension : mExtensionStrings)
+        fprintf(stderr, " %s", extension);
+    fprintf(stderr, "\n");
+
+    // The display (frontend + backend) features are shared by all the contexts of the
+    // display, so they are logged only once per process.
+    static bool sFeaturesLogged = false;
+    if (display && !sFeaturesLogged)
+    {
+        sFeaturesLogged = true;
+        fprintf(stderr, "[ANGLE] [%.6f] CONFIG display %p enabled features:", timestamp,
+                static_cast<const void *>(display));
+        for (const angle::FeatureInfo *feature : display->getFeatures())
+        {
+            if (feature->enabled)
+                fprintf(stderr, " %s", feature->name);
+        }
+        fprintf(stderr, "\n");
+
+        // Extensions of the native driver below ANGLE. They are shared by all the contexts of
+        // the display, whatever their client version.
+        if (const rx::DisplayImpl *displayImpl = display->getImplementation())
+        {
+            const std::vector<std::string> nativeEGLExtensions =
+                displayImpl->getNativeEGLExtensions();
+            fprintf(stderr, "[ANGLE] [%.6f] CONFIG display %p native driver EGL extensions (%zu):",
+                    timestamp, static_cast<const void *>(display), nativeEGLExtensions.size());
+            for (const std::string &extension : nativeEGLExtensions)
+                fprintf(stderr, " %s", extension.c_str());
+            fprintf(stderr, "\n");
+
+            const std::vector<std::string> nativeGLExtensions =
+                displayImpl->getNativeGLExtensions();
+            fprintf(stderr,
+                    "[ANGLE] [%.6f] CONFIG display %p native driver GL/GLES extensions (%zu):",
+                    timestamp, static_cast<const void *>(display), nativeGLExtensions.size());
+            for (const std::string &extension : nativeGLExtensions)
+                fprintf(stderr, " %s", extension.c_str());
+            fprintf(stderr, "\n");
+        }
+    }
+    fflush(stderr);
+}
