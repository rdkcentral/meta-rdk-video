+void GraphicsContextGLANGLE::logDrawingBufferAllocationForMemoryDebugging(int width, int height, GCGLint sampleCount)
+{
+    auto attrs = contextAttributes();
+    const uint64_t pixels = static_cast<uint64_t>(std::max(width, 0)) * static_cast<uint64_t>(std::max(height, 0));
+    const unsigned colorBpp = attrs.alpha ? 4 : 3;
+    unsigned depthStencilBpp = 0;
+    switch (m_internalDepthStencilFormat) {
+    case GL_DEPTH24_STENCIL8_OES:
+    case GL_DEPTH_COMPONENT24_OES:
+        depthStencilBpp = 4;
+        break;
+    case GL_DEPTH_COMPONENT16:
+        depthStencilBpp = 2;
+        break;
+    case GL_STENCIL_INDEX8:
+        depthStencilBpp = 1;
+        break;
+    default:
+        break;
+    }
+    const bool hasDepthStencil = attrs.depth || attrs.stencil;
+    const uint64_t multisampleBytes = attrs.antialias ? pixels * sampleCount * (colorBpp + (hasDepthStencil ? depthStencilBpp : 0)) : 0;
+    const uint64_t singleSampleDepthStencilBytes = !attrs.antialias && hasDepthStencil ? pixels * depthStencilBpp : 0;
+    const uint64_t drawingBufferBytes = pixels * colorBpp;
+    const uint64_t preserveBytes = m_preserveDrawingBufferTexture ? pixels * colorBpp : 0;
+    const uint64_t total = multisampleBytes + singleSampleDepthStencilBytes + drawingBufferBytes + preserveBytes;
+    WTFLogAlways("[WebGL] [%.6f] DRAWING BUFFER GraphicsContextGL %p (WebGL%d): reshape to %dx%d | multisample (%d samples) color+depth/stencil ~%" PRIu64 " bytes | depth/stencil rb ~%" PRIu64 " bytes | drawing buffer ~%" PRIu64 " bytes | preserveDrawingBuffer texture ~%" PRIu64 " bytes | total ~%" PRIu64 " bytes (%.2f MiB)",
+        angle_resource_tracker_timestamp_seconds(), this, m_isForWebGL2 ? 2 : 1, width, height, attrs.antialias ? sampleCount : 0,
+        multisampleBytes, singleSampleDepthStencilBytes, drawingBufferBytes, preserveBytes, total, static_cast<double>(total) / (1024.0 * 1024.0));
+}
