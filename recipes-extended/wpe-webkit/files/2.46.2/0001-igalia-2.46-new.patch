+  private:
+    const ErrorSet *mErrors;
+    uint32_t mOutOfMemoryErrorCount;
+    GLuint mTextureId;
+    const char *mOperation;
+    GLenum mTarget;
+    GLint mLevel;
+    GLsizei mLevels;
+    GLenum mInternalFormat;
+    Extents mSize;
+    GLsizei mSamples;
+    int64_t mRequestedBytes;
+};
+
+// Estimated memory of the levels [firstLevel, lastLevel] (relative to the base level) of a mip
+// chain, including all the cube faces.
+int64_t EstimateMipChainMemory(TextureType type,
+                               const Extents &baseSize,
+                               const Format &format,
+                               GLuint firstLevel,
+                               GLuint lastLevel)
+{
+    const int64_t faces = type == TextureType::CubeMap ? 6 : 1;
+    int64_t total       = 0;
+    for (GLuint level = firstLevel; level <= lastLevel; level++)
+    {
+        Extents levelSize(std::max<int>(baseSize.width >> level, 1),
+                          std::max<int>(baseSize.height >> level, 1),
+                          IsArrayTextureType(type) ? baseSize.depth
+                                                   : std::max<int>(baseSize.depth >> level, 1));
+        total += faces * ResourceMemoryTracker::EstimateImageMemory(
+                             ImageDesc(levelSize, format, InitState::Initialized));
+    }
+    return total;
+}
