+// Same as LogNativeTextureDefinition() for compressed formats. ANGLE's GL backend passes the
+// compressed data to the driver, but the driver may not support the format in hardware and
+// decompress it on upload (e.g. ETC2/EAC is mandatory in ES 3.0, so drivers for GPUs without
+// ETC2 decoding emulate it). This logs what the driver reports about the format and the
+// texture it created, plus the size of the decompressed data for comparison.
+// Must be called with the texture bound and after the native call succeeded.
+void LogNativeCompressedTextureDefinition(const gl::Context *context,
+                                          const FunctionsGL *functions,
+                                          const char *operation,
+                                          GLuint nativeId,
+                                          gl::TextureType textureType,
+                                          GLenum target,
+                                          size_t level,
+                                          size_t levels,
+                                          GLenum requestedInternalFormat,
+                                          const gl::InternalFormat &frontendInfo,
+                                          GLenum nativeInternalFormat,
+                                          const gl::Extents &size,
+                                          size_t uploadedDataSize)
+{
+    const bool isCubeMap  = textureType == gl::TextureType::CubeMap;
+    const int64_t faces   = isCubeMap && target == GL_TEXTURE_CUBE_MAP ? 6 : 1;
+    int64_t compressedBytes   = 0;
+    int64_t decompressedBytes = 0;
+    for (size_t i = 0; i < std::max<size_t>(levels, 1); ++i)
+    {
+        const GLsizei w = std::max(size.width >> i, 1);
+        const GLsizei h = std::max(size.height >> i, 1);
+        const GLsizei d =
+            textureType == gl::TextureType::_3D ? std::max(size.depth >> i, 1) : size.depth;
+        GLuint levelBytes = 0;
+        if (frontendInfo.computeCompressedImageSize(gl::Extents(w, h, d), &levelBytes))
+            compressedBytes += static_cast<int64_t>(levelBytes) * faces;
+        // What a driver decompressing to RGBA8 would store.
+        decompressedBytes += static_cast<int64_t>(w) * h * d * 4 * faces;
+    }
+
+    // Whether the driver lists the native format among its supported compressed formats.
+    GLint numFormats = 0;
+    functions->getIntegerv(GL_NUM_COMPRESSED_TEXTURE_FORMATS, &numFormats);
+    bool advertised = false;
+    if (numFormats > 0)
+    {
+        std::vector<GLint> formats(numFormats);
+        functions->getIntegerv(GL_COMPRESSED_TEXTURE_FORMATS, formats.data());
+        advertised = std::find(formats.begin(), formats.end(),
+                               static_cast<GLint>(nativeInternalFormat)) != formats.end();
+    }
+
+    // What the driver says about the texture it created. Querying level parameters is only
+    // possible on desktop GL and ES 3.1+, and the compressed image size only on desktop GL.
+    // A driver that decompressed the data may still report the compressed format and size.
+    GLint driverCompressed = -1, driverInternalFormat = -1, driverImageSize = -1;
+    const bool isDesktop = functions->standard == STANDARD_GL_DESKTOP;
+    if (functions->getTexLevelParameteriv &&
+        (isDesktop || functions->isAtLeastGLES(gl::Version(3, 1))))
+    {
+        const GLenum queryTarget =
+            isCubeMap && target == GL_TEXTURE_CUBE_MAP ? GL_TEXTURE_CUBE_MAP_POSITIVE_X : target;
+        const GLint queryLevel = static_cast<GLint>(level);
+        functions->getTexLevelParameteriv(queryTarget, queryLevel, GL_TEXTURE_COMPRESSED,
+                                          &driverCompressed);
+        functions->getTexLevelParameteriv(queryTarget, queryLevel, GL_TEXTURE_INTERNAL_FORMAT,
+                                          &driverInternalFormat);
+        if (isDesktop && driverCompressed > 0)
+        {
+            functions->getTexLevelParameteriv(queryTarget, queryLevel,
+                                              GL_TEXTURE_COMPRESSED_IMAGE_SIZE, &driverImageSize);
+        }
+    }
+
+    fprintf(stderr,
+            "[ANGLE] [%.6f] NATIVE COMPRESSED TEXTURE context %p (ES %d.%d, WebGL version %d): %s native "
+            "texture %u target 0x%04X level %zu levels %zu size %dx%dx%d | requested "
+            "internalformat 0x%04X -> native internalformat 0x%04X%s | uploaded data %zu bytes, "
+            "estimated compressed storage %" PRId64 " bytes (%.2f MiB), decompressed RGBA8 "
+            "equivalent %" PRId64 " bytes (%.2f MiB, %.1fx) | driver advertises format in "
+            "GL_COMPRESSED_TEXTURE_FORMATS: %d (%d formats) | driver level query: compressed %d, "
+            "internalformat 0x%04X, compressed image size %d\n",
+            angle_resource_tracker_timestamp_seconds(), static_cast<const void *>(context),
+            context->getClientVersion().major, context->getClientVersion().minor,
+            (context->isWebGL() ? (context->getClientVersion().major >= 3 ? 2 : 1) : 0), operation, nativeId, target, level, levels, size.width,
+            size.height, size.depth, requestedInternalFormat, nativeInternalFormat,
+            nativeInternalFormat != requestedInternalFormat ? " [NATIVE FORMAT DIFFERS]" : "",
+            uploadedDataSize, compressedBytes,
+            static_cast<double>(compressedBytes) / (1024.0 * 1024.0), decompressedBytes,
+            static_cast<double>(decompressedBytes) / (1024.0 * 1024.0),
+            compressedBytes ? static_cast<double>(decompressedBytes) / compressedBytes : 0.0,
+            advertised, numFormats, driverCompressed, driverInternalFormat, driverImageSize);
+    fflush(stderr);
+}
+
