+// [GPUDEBUG] per-process accounting of native GL texture memory (estimated, excludes driver padding).
+namespace gpudbg
+{
+std::mutex gMutex;
+std::map<const void *, std::map<uint32_t, uint64_t>> gTexBytes;
+uint64_t gLiveBytes = 0, gPeakBytes = 0, gCreated = 0, gDestroyed = 0, gEvents = 0;
+
+void Register(const void *tex)
+{
+    std::lock_guard<std::mutex> l(gMutex);
+    gTexBytes[tex];
+    gCreated++;
+}
+
+void SetLevel(const void *tex, uint32_t key, uint64_t bytes)
+{
+    std::lock_guard<std::mutex> l(gMutex);
+    uint64_t &slot = gTexBytes[tex][key];
+    gLiveBytes     = gLiveBytes - slot + bytes;
+    slot           = bytes;
+    if (gLiveBytes > gPeakBytes)
+        gPeakBytes = gLiveBytes;
+}
+
+uint64_t Release(const void *tex)
+{
+    std::lock_guard<std::mutex> l(gMutex);
+    uint64_t freed = 0;
+    auto it        = gTexBytes.find(tex);
+    if (it != gTexBytes.end())
+    {
+        for (auto &lv : it->second)
+            freed += lv.second;
+        gTexBytes.erase(it);
+    }
+    gLiveBytes -= freed;
+    gDestroyed++;
+    return freed;
+}
+
+uint64_t LiveBytes()
+{
+    std::lock_guard<std::mutex> l(gMutex);
+    return gLiveBytes;
+}
+
+bool ShouldPeriodicDump()
+{
+    std::lock_guard<std::mutex> l(gMutex);
+    return (++gEvents % 25) == 0;
+}
+
+void DumpProcFile(const char *path, const char *const keys[], size_t n)
+{
+    FILE *f = fopen(path, "r");
+    if (!f)
+        return;
+    char line[256];
+    while (fgets(line, sizeof(line), f))
+    {
+        for (size_t i = 0; i < n; i++)
+        {
+            if (!strncmp(line, keys[i], strlen(keys[i])))
+                fprintf(stderr, "[GPUDEBUG]   %s: %s", path, line);
+        }
+    }
+    fclose(f);
+}
+}  // namespace gpudbg
+
+void GpuDbgDumpStats(const char *reason)
+{
+    {
+        std::lock_guard<std::mutex> l(gpudbg::gMutex);
+        size_t b64k = 0, b256k = 0, b1m = 0, bBig = 0;
+        for (auto &t : gpudbg::gTexBytes)
+        {
+            uint64_t s = 0;
+            for (auto &lv : t.second)
+                s += lv.second;
+            if (s < 65536)
+                b64k++;
+            else if (s < 262144)
+                b256k++;
+            else if (s < 1048576)
+                b1m++;
+            else
+                bBig++;
+        }
+        fprintf(stderr,
+                "[GPUDEBUG] STATS reason=%s pid=%d liveTex=%zu created=%llu destroyed=%llu "
+                "liveBytes=%llu peakBytes=%llu hist[<64K=%zu <256K=%zu <1M=%zu >=1M=%zu]\n",
+                reason, getpid(), gpudbg::gTexBytes.size(),
+                static_cast<unsigned long long>(gpudbg::gCreated),
+                static_cast<unsigned long long>(gpudbg::gDestroyed),
+                static_cast<unsigned long long>(gpudbg::gLiveBytes),
+                static_cast<unsigned long long>(gpudbg::gPeakBytes), b64k, b256k, b1m, bBig);
+    }
+    static const char *const memKeys[]  = {"MemFree", "MemAvailable", "CmaTotal", "CmaFree"};
+    static const char *const selfKeys[] = {"VmRSS", "VmSize"};
+    gpudbg::DumpProcFile("/proc/meminfo", memKeys, 4);
+    gpudbg::DumpProcFile("/proc/self/status", selfKeys, 2);
+}
