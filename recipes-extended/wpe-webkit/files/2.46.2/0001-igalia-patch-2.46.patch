+// Logs an out of memory error if the context reports a new GL_OUT_OF_MEMORY while this object is
+// alive. It wraps the backend calls that allocate texture storage, so both driver allocation
+// failures and ANGLE's own (CPU) allocation failures are reported.
+class ScopedTextureOutOfMemoryCheck final : angle::NonCopyable
+{
+  public:
+    ScopedTextureOutOfMemoryCheck(const Context *context,
+                                  GLuint textureId,
+                                  const char *operation,
+                                  GLenum target,
+                                  GLint level,
+                                  GLsizei levels,
+                                  GLenum internalFormat,
+                                  const Extents &size,
+                                  GLsizei samples,
+                                  int64_t requestedBytes)
+        : mErrors(context->getMutableErrorSetForValidation()),
