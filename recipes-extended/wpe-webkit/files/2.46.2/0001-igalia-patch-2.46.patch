diff --git a/Source/ThirdParty/ANGLE/src/libANGLE/ResourceMemoryTracker.cpp b/Source/ThirdParty/ANGLE/src/libANGLE/ResourceMemoryTracker.cpp
new file mode 100644
index 000000000000..bd5026ea7471
--- /dev/null
+++ b/Source/ThirdParty/ANGLE/src/libANGLE/ResourceMemoryTracker.cpp
@@ -0,0 +1,207 @@
+//
+// Copyright 2026 Igalia S.L. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+
+// ResourceMemoryTracker.cpp: Implements gl::ResourceMemoryTracker.
+
+#include "libANGLE/ResourceMemoryTracker.h"
+
+#include "libANGLE/Texture.h"
+#include "libANGLE/formatutils.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cinttypes>
+#include <cstdio>
+#include <limits>
+#include <mutex>
+
+namespace gl
+{
+namespace
+{
+struct ResourceTotals
+{
+    int64_t count = 0;
+    int64_t bytes = 0;
+};
+
+constexpr size_t kTypeCount = static_cast<size_t>(TrackedResourceType::EnumCount);
+
+std::mutex &TrackerMutex()
+{
+    static std::mutex mutex;
+    return mutex;
+}
+
+std::array<ResourceTotals, kTypeCount> &Totals()
+{
+    static std::array<ResourceTotals, kTypeCount> totals;
+    return totals;
+}
+
+const char *TypeName(TrackedResourceType type)
+{
+    switch (type)
+    {
+        case TrackedResourceType::Texture:
+            return "texture";
+        case TrackedResourceType::Renderbuffer:
+            return "renderbuffer";
+        case TrackedResourceType::Buffer:
+            return "buffer";
+        case TrackedResourceType::InternalTexture:
+            return "internal texture";
+        default:
+            return "unknown";
+    }
+}
+
+double ToMiB(int64_t bytes)
+{
+    return static_cast<double>(bytes) / (1024.0 * 1024.0);
+}
+
+// Must be called with the tracker mutex held.
+void LogTotals(const char *event, TrackedResourceType type, GLuint id, int64_t deltaBytes)
+{
+    const auto &totals         = Totals();
+    const ResourceTotals &tex  = totals[static_cast<size_t>(TrackedResourceType::Texture)];
+    const ResourceTotals &rb   = totals[static_cast<size_t>(TrackedResourceType::Renderbuffer)];
+    const ResourceTotals &buf  = totals[static_cast<size_t>(TrackedResourceType::Buffer)];
+    const ResourceTotals &itex = totals[static_cast<size_t>(TrackedResourceType::InternalTexture)];
+    const int64_t total        = tex.bytes + rb.bytes + buf.bytes;
+
+    fprintf(stderr,
+            "[ANGLE] [%.6f] %s %s %u (%+" PRId64 " bytes) => "
+            "textures: %" PRId64 " (%" PRId64 " bytes, %.2f MiB) | "
+            "renderbuffers: %" PRId64 " (%" PRId64 " bytes, %.2f MiB) | "
+            "buffers: %" PRId64 " (%" PRId64 " bytes, %.2f MiB) | "
+            "total: %" PRId64 " bytes (%.2f MiB) | "
+            "ANGLE internal textures: %" PRId64 " (%" PRId64 " bytes)\n",
+            angle_resource_tracker_timestamp_seconds(), event, TypeName(type), id, deltaBytes, tex.count, tex.bytes, ToMiB(tex.bytes),
+            rb.count, rb.bytes, ToMiB(rb.bytes), buf.count, buf.bytes, ToMiB(buf.bytes), total,
+            ToMiB(total), itex.count, itex.bytes);
+    fflush(stderr);
+}
+}  // anonymous namespace
+
+// static
+void ResourceMemoryTracker::OnCreated(TrackedResourceType type, GLuint id)
+{
+    std::lock_guard<std::mutex> lock(TrackerMutex());
+    Totals()[static_cast<size_t>(type)].count++;
+    LogTotals("created", type, id, 0);
+}
+
+// static
+void ResourceMemoryTracker::OnDestroyed(TrackedResourceType type,
+                                        GLuint id,
+                                        int64_t remainingBytes)
+{
+    std::lock_guard<std::mutex> lock(TrackerMutex());
+    ResourceTotals &totals = Totals()[static_cast<size_t>(type)];
+    totals.count--;
+    totals.bytes -= remainingBytes;
+    LogTotals("destroyed", type, id, -remainingBytes);
+}
+
+// static
+void ResourceMemoryTracker::OnMemoryChanged(TrackedResourceType type,
+                                            GLuint id,
+                                            int64_t deltaBytes)
+{
+    if (!deltaBytes)
+        return;
+
+    std::lock_guard<std::mutex> lock(TrackerMutex());
+    Totals()[static_cast<size_t>(type)].bytes += deltaBytes;
+    LogTotals(deltaBytes > 0 ? "allocated" : "released", type, id, deltaBytes);
+}
+
+// static
+void ResourceMemoryTracker::OnTextureOutOfMemory(GLuint id,
+                                                 const char *operation,
+                                                 GLenum target,
+                                                 GLint level,
+                                                 GLsizei levels,
+                                                 GLenum internalFormat,
+                                                 GLsizei width,
+                                                 GLsizei height,
+                                                 GLsizei depth,
+                                                 GLsizei samples,
+                                                 int64_t requestedBytes)
+{
+    std::lock_guard<std::mutex> lock(TrackerMutex());
+    const auto &totals         = Totals();
+    const ResourceTotals &tex  = totals[static_cast<size_t>(TrackedResourceType::Texture)];
+    const ResourceTotals &rb   = totals[static_cast<size_t>(TrackedResourceType::Renderbuffer)];
+    const ResourceTotals &buf  = totals[static_cast<size_t>(TrackedResourceType::Buffer)];
+    const int64_t total        = tex.bytes + rb.bytes + buf.bytes;
+
+    fprintf(stderr,
+            "[ANGLE] [%.6f] OUT OF MEMORY: %s failed for texture %u (target 0x%04X, level %d, "
+            "levels %d, size %dx%dx%d, samples %d, internal format 0x%04X, requested ~%" PRId64
+            " bytes, %.2f MiB) => allocated so far: textures: %" PRId64 " (%" PRId64
+            " bytes, %.2f MiB) | renderbuffers: %" PRId64 " (%" PRId64
+            " bytes, %.2f MiB) | buffers: %" PRId64 " (%" PRId64
+            " bytes, %.2f MiB) | total: %" PRId64 " bytes (%.2f MiB)\n",
+            angle_resource_tracker_timestamp_seconds(), operation, id, target, level, levels, width,
+            height, depth, samples, internalFormat, requestedBytes, ToMiB(requestedBytes),
+            tex.count, tex.bytes, ToMiB(tex.bytes), rb.count, rb.bytes, ToMiB(rb.bytes), buf.count,
+            buf.bytes, ToMiB(buf.bytes), total, ToMiB(total));
+    fflush(stderr);
+}
+
+// static
+TrackedResourceType ResourceMemoryTracker::TextureTypeForId(GLuint id)
+{
+    // Zero textures use id 0, incomplete textures use the max GLuint value.
+    if (id == 0 || id == std::numeric_limits<GLuint>::max())
+        return TrackedResourceType::InternalTexture;
+    return TrackedResourceType::Texture;
+}
+
+// static
+int64_t ResourceMemoryTracker::EstimateImageMemory(const ImageDesc &desc)
+{
+    if (desc.size.empty() || !desc.format.info)
+        return 0;
+
+    const InternalFormat &info = *desc.format.info;
+    if (info.compressed)
+    {
+        GLuint compressedSize = 0;
+        if (!info.computeCompressedImageSize(desc.size, &compressedSize))
+            return 0;
+        return static_cast<int64_t>(compressedSize);
+    }
+
+    return static_cast<int64_t>(info.pixelBytes) * desc.size.width * desc.size.height *
+           desc.size.depth * std::max<GLsizei>(desc.samples, 1);
+}
+
+// static
+int64_t ResourceMemoryTracker::EstimateRenderbufferMemory(GLsizei width,
+                                                          GLsizei height,
+                                                          const Format &format,
+                                                          GLsizei samples)
+{
+    if (width <= 0 || height <= 0 || !format.info)
+        return 0;
+
+    return static_cast<int64_t>(format.info->pixelBytes) * width * height *
+           std::max<GLsizei>(samples, 1);
+}
+
+}  // namespace gl
+
+extern "C" double angle_resource_tracker_timestamp_seconds()
+{
+    // Initialized (thread-safely) on the first call.
+    static const std::chrono::steady_clock::time_point startTime = std::chrono::steady_clock::now();
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() - startTime).count();
+}
diff --git a/Source/ThirdParty/ANGLE/src/libANGLE/ResourceMemoryTracker.h b/Source/ThirdParty/ANGLE/src/libANGLE/ResourceMemoryTracker.h
new file mode 100644
index 000000000000..7ceab36c89ea
--- /dev/null
+++ b/Source/ThirdParty/ANGLE/src/libANGLE/ResourceMemoryTracker.h
@@ -0,0 +1,78 @@
+//
+// Copyright 2026 Igalia S.L. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+
+// ResourceMemoryTracker.h: Process-wide bookkeeping of the frontend GL objects that can consume
+// a significant amount of (video) memory: textures, renderbuffers and buffers. Every time one of
+// those objects is created, destroyed or its storage changes, the current totals are written to
+// stderr, so they can be compared with the ones tracked by the WebGL implementation on top of
+// ANGLE (WebCore::WebGLResourceTracker).
+//
+// The memory figures are estimations based on the frontend state (image descs, renderbuffer
+// size and format, buffer size); backends may allocate more (padding, emulated formats, etc).
+
+#ifndef LIBANGLE_RESOURCEMEMORYTRACKER_H_
+#define LIBANGLE_RESOURCEMEMORYTRACKER_H_
+
+#include "angle_gl.h"
+
+#include <cstdint>
+
+namespace gl
+{
+struct ImageDesc;
+struct Format;
+
+enum class TrackedResourceType
+{
+    // Textures created by the application (the ones WebGL knows about).
+    Texture,
+    Renderbuffer,
+    Buffer,
+    // Textures that ANGLE creates for itself: the per-context default (zero) textures and the
+    // incomplete textures used when sampling from incomplete textures.
+    InternalTexture,
+
+    EnumCount,
+};
+
+class ResourceMemoryTracker final
+{
+  public:
+    static void OnCreated(TrackedResourceType type, GLuint id);
+    static void OnDestroyed(TrackedResourceType type, GLuint id, int64_t remainingBytes);
+    static void OnMemoryChanged(TrackedResourceType type, GLuint id, int64_t deltaBytes);
+
+    // Logs that allocating the storage of a texture failed with GL_OUT_OF_MEMORY, either in the
+    // driver or in ANGLE itself. |requestedBytes| is the estimated size of what was requested.
+    static void OnTextureOutOfMemory(GLuint id,
+                                     const char *operation,
+                                     GLenum target,
+                                     GLint level,
+                                     GLsizei levels,
+                                     GLenum internalFormat,
+                                     GLsizei width,
+                                     GLsizei height,
+                                     GLsizei depth,
+                                     GLsizei samples,
+                                     int64_t requestedBytes);
+
+    static TrackedResourceType TextureTypeForId(GLuint id);
+
+    static int64_t EstimateImageMemory(const ImageDesc &desc);
+    static int64_t EstimateRenderbufferMemory(GLsizei width,
+                                              GLsizei height,
+                                              const Format &format,
+                                              GLsizei samples);
+};
+
+}  // namespace gl
+
+// Seconds elapsed since the first call to this function, which therefore returns 0 the first
+// time. It is the clock used for the log timestamps of both this tracker and WebKit's
+// WebGLResourceTracker, so the first event received by either of them sets time 0. Thread safe.
+extern "C" double angle_resource_tracker_timestamp_seconds();
+
+#endif  // LIBANGLE_RESOURCEMEMORYTRACKER_H_
