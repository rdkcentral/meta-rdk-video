+#pragma once
+
+#if ENABLE(WEBGL)
+
+#include "GraphicsTypesGL.h"
+#include <map>
+#include <wtf/Lock.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/Noncopyable.h>
+
+namespace WebCore {
+
+// Process-wide bookkeeping of the WebGL resources that can consume a significant amount of
+// (video) memory: textures, renderbuffers and buffers. The resources are tracked at the
+// WebGLRenderingContext level, so only the resources created through the WebGL API are
+// accounted. The resources that GraphicsContextGL creates internally to implement the drawing
+// buffer (color textures, multisample/depth/stencil renderbuffers) are not included.
+//
+// Every time a resource is created or deleted, or its storage size changes, the current totals
+// are logged. ANGLE keeps the same bookkeeping on its side (gl::ResourceMemoryTracker), and logs
+// it with the "[ANGLE resources]" prefix, so both can be compared.
+//
+// Memory figures are estimations: width * height * depth * bytes per pixel * samples for each
+// image, the compressed size for compressed images, and the size for buffers.
+class WebGLResourceTracker {
+    WTF_MAKE_NONCOPYABLE(WebGLResourceTracker);
+public:
+    static WebGLResourceTracker& singleton();
+
+    // context identifies the WebGLRenderingContextBase, and the objects are identified by their
+    // GL name.
+    void textureCreated(const void* context, GCGLuint texture);
+    void textureDeleted(const void* context, GCGLuint texture);
+    // Defines (or redefines) one image (a level of a face) of the texture. Pass
+    // bytesPerPixel = 0 for compressed images, as their size is given by compressedSize.
+    void textureImageDefined(const void* context, GCGLuint texture, GCGLenum target, GCGLint level, GCGLsizei width, GCGLsizei height, GCGLsizei depth, unsigned bytesPerPixel, uint64_t compressedSize, const char* operation);
+    // texStorage2D/3D: replaces all the images of the texture with a full mip chain.
+    void textureStorageDefined(const void* context, GCGLuint texture, GCGLenum target, GCGLsizei levels, GCGLenum internalFormat, GCGLsizei width, GCGLsizei height, GCGLsizei depth, const char* operation);
+    void textureMipmapsGenerated(const void* context, GCGLuint texture, GCGLenum target, GCGLint baseLevel, GCGLint maxLevel);
+
+    void renderbufferCreated(const void* context, GCGLuint renderbuffer);
+    void renderbufferDeleted(const void* context, GCGLuint renderbuffer);
+    void renderbufferStorageDefined(const void* context, GCGLuint renderbuffer, GCGLenum internalFormat, GCGLsizei samples, GCGLsizei width, GCGLsizei height, const char* operation);
+
+    void bufferCreated(const void* context, GCGLuint buffer);
+    void bufferDeleted(const void* context, GCGLuint buffer);
+    void bufferDataDefined(const void* context, GCGLuint buffer, uint64_t size, const char* operation);
+
+    // The context detached all its objects (context lost or destroyed) without deleting them.
+    void contextObjectsDetached(const void* context);
+
+    // Bytes per pixel of an uncompressed image, 0 for compressed or unknown formats.
+    static unsigned bytesPerPixel(GCGLenum internalFormat, GCGLenum format, GCGLenum type);
+    // Size of a compressed image, 0 if the format is not a known compressed one.
+    static uint64_t compressedImageSize(GCGLenum internalFormat, GCGLsizei width, GCGLsizei height, GCGLsizei depth);
+
+private:
+    friend class NeverDestroyed<WebGLResourceTracker>;
+    WebGLResourceTracker() = default;
+
+    enum class Type : uint8_t { Texture, Renderbuffer, Buffer };
+    static constexpr size_t typeCount = 3;
+
+    using ObjectKey = std::pair<const void*, GCGLuint>;
+
+    struct ImageInfo {
+        GCGLsizei width { 0 };
+        GCGLsizei height { 0 };
+        GCGLsizei depth { 0 };
+        unsigned bytesPerPixel { 0 };
+        uint64_t bytes { 0 };
+    };
+
+    struct Resource {
+        explicit Resource(Type type)
+            : type(type)
+        {
+        }
+
+        Type type;
+        uint64_t bytes { 0 };
+        // Textures only.
+        bool immutable { false };
+        std::map<std::pair<GCGLenum, GCGLint>, ImageInfo> images;
+    };
+
+    struct Totals {
+        uint64_t count { 0 };
+        uint64_t bytes { 0 };
+    };
+
+    Resource& ensureResource(const void* context, GCGLuint, Type) WTF_REQUIRES_LOCK(m_lock);
+    void addResource(const void* context, GCGLuint, Type, const char* operation) WTF_REQUIRES_LOCK(m_lock);
+    void removeResource(const void* context, GCGLuint, Type, const char* operation) WTF_REQUIRES_LOCK(m_lock);
+    void setResourceBytes(Resource&, uint64_t bytes) WTF_REQUIRES_LOCK(m_lock);
+    void setTextureImage(Resource&, GCGLenum target, GCGLint level, const ImageInfo&) WTF_REQUIRES_LOCK(m_lock);
+    void logChange(const char* operation, Type, GCGLuint, uint64_t previousBytes, uint64_t newBytes) WTF_REQUIRES_LOCK(m_lock);
+    void logTotals(const char* operation, Type, GCGLuint, int64_t deltaBytes) WTF_REQUIRES_LOCK(m_lock);
+    // Log timestamp: seconds since the first event received by this tracker or ANGLE's.
+    static double elapsedSeconds();
+
+    Lock m_lock;
+    std::map<ObjectKey, Resource> m_resources WTF_GUARDED_BY_LOCK(m_lock);
+    Totals m_totals[typeCount] WTF_GUARDED_BY_LOCK(m_lock);
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(WEBGL)
