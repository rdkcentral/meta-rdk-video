     void invalidateOnCurrentThread()
@@ -206,7 +213,18 @@ GLContext* PlatformDisplay::skiaGLContext()
 GrDirectContext* PlatformDisplay::skiaGrContext()
 {
     RELEASE_ASSERT(s_skiaGLContext);
-    return s_skiaGLContext->skiaGrContext();
+    auto* grContext = s_skiaGLContext->skiaGrContext();
+    static thread_local time_t s_lastCacheLog = 0;
+    time_t now = time(nullptr);
+    if (grContext && now - s_lastCacheLog >= 5) {
+        s_lastCacheLog = now;
+        int resourceCount = 0;
+        size_t resourceBytes = 0;
+        grContext->getResourceCacheUsage(&resourceCount, &resourceBytes);
+        fprintf(stderr, "[GPUDEBUG] SKIA_GPU_CACHE pid=%d tid=%d grContext=%p resources=%d bytes=%zu purgeableBytes=%zu limitBytes=%zu\n",
+            getpid(), static_cast<int>(gettid()), grContext, resourceCount, resourceBytes, grContext->getResourceCachePurgeableBytes(), grContext->getResourceCacheLimit());
