diff --git a/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/TextureGL.cpp b/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/TextureGL.cpp
index 397b2410a72f..1e7f01e232c7 100644
--- a/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/TextureGL.cpp
+++ b/Source/ThirdParty/ANGLE/src/libANGLE/renderer/gl/TextureGL.cpp
@@ -37,6 +37,8 @@
 #include <mutex>
 #include <unistd.h>
 
+#include "../../../../../../WebCore/platform/graphics/GPUDebugNexus.h"
+
 using angle::CheckedNumeric;
 
 namespace rx
@@ -144,6 +146,7 @@ void GpuDbgDumpStats(const char *reason)
     static const char *const selfKeys[] = {"VmRSS", "VmSize"};
     gpudbg::DumpProcFile("/proc/meminfo", memKeys, 4);
     gpudbg::DumpProcFile("/proc/self/status", selfKeys, 2);
+    GPUDebugNexus::dump(reason);
 }
 
 namespace
@@ -290,7 +293,19 @@ void TextureGL::onDestroy(const gl::Context *context)
         GpuDbgDumpStats("periodic");
     GetImplAs<ContextGL>(context)->flushIfNecessaryBeforeDeleteTextures();
     StateManagerGL *stateManager = GetStateManagerGL(context);
+    GPUDebugNexus::Snapshot gpuDbgBefore;
+    const bool gpuDbgMeasure = freed > 4 && GPUDebugNexus::takeSnapshot(gpuDbgBefore);
     stateManager->deleteTexture(mTextureID);
+    if (gpuDbgMeasure)
+    {
+        GPUDebugNexus::Snapshot gpuDbgAfter;
+        if (GPUDebugNexus::takeSnapshot(gpuDbgAfter))
+        {
+            char tag[96];
+            snprintf(tag, sizeof(tag), "ANGLE_TEXDELETE texture=%u", mTextureID);
+            GPUDebugNexus::dumpDelta(tag, gpuDbgBefore, gpuDbgAfter, freed);
+        }
+    }
     mTextureID = 0;
 }
 
@@ -385,6 +400,13 @@ angle::Result TextureGL::setImageHelper(const gl::Context *context,
         (void)setBaseLevel(context, 0);
     }
 
+    const unsigned long long gpuDbgEstBytes = static_cast<unsigned long long>(size.width) * size.height * size.depth *
+        std::max<GLuint>(originalInternalFormatInfo.pixelBytes, 1);
+    const bool gpuDbgMeasure = gpuDbgEstBytes > 4;
+    GPUDebugNexus::Snapshot gpuDbgBefore;
+    if (gpuDbgMeasure)
+        GPUDebugNexus::takeSnapshot(gpuDbgBefore);
+
     if (nativegl::UseTexImage2D(getType()))
     {
         ASSERT(size.depth == 1);
@@ -413,6 +435,17 @@ angle::Result TextureGL::setImageHelper(const gl::Context *context,
     }
 
     // Reached only when the driver accepted the allocation.
+    if (gpuDbgMeasure)
+    {
+        GPUDebugNexus::Snapshot gpuDbgAfter;
+        if (GPUDebugNexus::takeSnapshot(gpuDbgAfter))
+        {
+            char tag[128];
+            snprintf(tag, sizeof(tag), "ANGLE_TEXIMAGE texture=%u %dx%d level=%zu", mTextureID,
+                     size.width, size.height, level);
+            GPUDebugNexus::dumpDelta(tag, gpuDbgBefore, gpuDbgAfter, gpuDbgEstBytes);
+        }
+    }
     gpudbg::SetLevel(this, static_cast<uint32_t>(target) * 64 + static_cast<uint32_t>(level),
                      static_cast<uint64_t>(size.width) * size.height * size.depth *
                          std::max<GLuint>(originalInternalFormatInfo.pixelBytes, 1));
diff --git a/Source/WebCore/page/MemoryRelease.cpp b/Source/WebCore/page/MemoryRelease.cpp
index 43220fab3cf5..fd663f61d2f2 100644
--- a/Source/WebCore/page/MemoryRelease.cpp
+++ b/Source/WebCore/page/MemoryRelease.cpp
@@ -27,6 +27,8 @@
 #include "MemoryRelease.h"
 
 #include <stdio.h>
+#include <time.h>
+#include "GPUDebugNexus.h"
 #include "BackForwardCache.h"
 #include "CSSFontSelector.h"
 #include "CSSValuePool.h"
@@ -162,6 +164,14 @@ void releaseMemory(Critical critical, Synchronous synchronous, MaintainBackForwa
 {
     TraceScope scope(MemoryPressureHandlerStart, MemoryPressureHandlerEnd, static_cast<uint64_t>(critical), static_cast<uint64_t>(synchronous));
     fprintf(stderr, "[GPUDEBUG] RELEASE_MEMORY critical=%d synchronous=%d\n", critical == Critical::Yes, synchronous == Synchronous::Yes);
+    {
+        static time_t s_gpuDbgLastNexusDump = 0;
+        time_t now = time(nullptr);
+        if (critical == Critical::Yes && now - s_gpuDbgLastNexusDump >= 10) {
+            s_gpuDbgLastNexusDump = now;
+            GPUDebugNexus::dump("RELEASE_MEMORY_CRITICAL");
+        }
+    }
 
 #if PLATFORM(IOS_FAMILY)
     if (critical == Critical::No)
diff --git a/Source/WebCore/platform/graphics/angle/GraphicsContextGLANGLE.cpp b/Source/WebCore/platform/graphics/angle/GraphicsContextGLANGLE.cpp
index 94c5193deffe..6dfc060e1df9 100644
--- a/Source/WebCore/platform/graphics/angle/GraphicsContextGLANGLE.cpp
+++ b/Source/WebCore/platform/graphics/angle/GraphicsContextGLANGLE.cpp
@@ -45,6 +45,7 @@
 #include <wtf/text/StringBuilder.h>
 #include <atomic>
 #include <stdio.h>
+#include "GPUDebugNexus.h"
 
 #if ENABLE(VIDEO) && USE(AVFOUNDATION)
 #include "GraphicsContextGLCVCocoa.h"
@@ -290,6 +291,11 @@ bool GraphicsContextGLANGLE::reshapeFBOs(const IntSize& size)
     const int width = size.width();
     const int height = size.height();
     GLuint colorFormat = attrs.alpha ? GL_RGBA : GL_RGB;
+    GPUDebugNexus::Snapshot gpuDbgBefore;
+    bool gpuDbgMeasure = GPUDebugNexus::takeSnapshot(gpuDbgBefore);
+    fprintf(stderr, "[GPUDEBUG] WEBGL_RESHAPE_FBOS ctx=%p %dx%d antialias=%d depth=%d stencil=%d alpha=%d preserveDrawingBuffer=%d premultipliedAlpha=%d webgl2=%d hostWindow=%d depthStencilFormat=0x%x\n",
+        this, width, height, attrs.antialias, attrs.depth, attrs.stencil, attrs.alpha, attrs.preserveDrawingBuffer, attrs.premultipliedAlpha, attrs.isWebGL2,
+        attrs.renderTarget == GraphicsContextGLRenderTarget::HostWindow, static_cast<unsigned>(m_internalDepthStencilFormat));
 
     // Resize multisample FBO.
     if (attrs.antialias) {
@@ -298,6 +304,9 @@ bool GraphicsContextGLANGLE::reshapeFBOs(const IntSize& size)
         // Using more than 4 samples is slow on some hardware and is unlikely to
         // produce a significantly better result.
         GLint sampleCount = std::min(4, maxSampleCount);
+        fprintf(stderr, "[GPUDEBUG] WEBGL_MSAA_ALLOC ctx=%p %dx%d samples=%d maxSamples=%d estColorBytes=%lld estDepthStencilBytes=%lld\n",
+            this, width, height, sampleCount, maxSampleCount, static_cast<long long>(width) * height * 4 * sampleCount,
+            (attrs.stencil || attrs.depth) ? static_cast<long long>(width) * height * 4 * sampleCount : 0LL);
         GL_BindFramebuffer(GL_FRAMEBUFFER, m_multisampleFBO);
         GL_BindRenderbuffer(GL_RENDERBUFFER, m_multisampleColorBuffer);
         GL_RenderbufferStorageMultisampleANGLE(GL_RENDERBUFFER, sampleCount, m_internalColorFormat, width, height);
@@ -362,6 +371,14 @@ bool GraphicsContextGLANGLE::reshapeFBOs(const IntSize& size)
             mustRestoreFBO = false;
     }
 
+    GL_Finish();
+    GPUDebugNexus::Snapshot gpuDbgAfter;
+    if (gpuDbgMeasure && GPUDebugNexus::takeSnapshot(gpuDbgAfter)) {
+        char tag[96];
+        snprintf(tag, sizeof(tag), "WEBGL_DRAWING_BUFFERS ctx=%p %dx%d", this, width, height);
+        GPUDebugNexus::dumpDelta(tag, gpuDbgBefore, gpuDbgAfter, static_cast<unsigned long long>(width) * height * 4);
+    }
+
     return mustRestoreFBO;
 }
 
