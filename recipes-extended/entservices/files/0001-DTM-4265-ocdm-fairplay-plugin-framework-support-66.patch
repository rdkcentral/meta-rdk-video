+                    if (system != nullptr) {
+                        CDMi::CDMi_RESULT mediasystem_return = system->DestroyMovieSession(version, movieId);
+                        if (mediasystem_return == CDMi::CDMi_RESULT::CDMi_SUCCESS)
+                        {
+                            result = Exchange::OCDM_SUCCESS;
+                        }
+                        else
+                        {
+                            result = Exchange::OCDM_S_FALSE;
+                        }
+                    }
+
+                    return result;
+            }
