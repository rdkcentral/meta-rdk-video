--- a/plugin/FrameworkRPC.cpp
+++ b/plugin/FrameworkRPC.cpp
@@ -855,7 +855,7 @@ namespace Plugin {
                     return (Exchange::OCDM_RESULT)_mediaKeySessionExt->CancelChallengeDataExt();
                 }
 
-                Exchange::OCDM_RESULT StoreLicenseData(const uint8_t licenseData[], uint16_t licenseDataSize, unsigned char* secureStopId) override
+                Exchange::OCDM_RESULT StoreLicenseData(const uint8_t licenseData[], uint16_t licenseDataSize, uint8_t* secureStopId) override
                 {
                     return (Exchange::OCDM_RESULT)_mediaKeySessionExt->StoreLicenseData(licenseData, licenseDataSize, secureStopId);
                 }
@@ -995,7 +995,7 @@ namespace Plugin {
                 return result;
             }
 
-            Exchange::OCDM_RESULT GenerateChallengeWithVersionList(const std::string& keySystem, uint32_t version, uint64_t movieId, const uint8_t* assetidData, uint32_t assetidSize, const uint8_t* versionlist, uint32_t versionListSize, const uint8_t* streamerChallengeData, uint32_t streamerChallengeSize, uint64_t cryptorId, uint8_t* licenseChallenge, uint8_t* licenseChallengeSize, uint8_t* session) const override
+            Exchange::OCDM_RESULT GenerateChallengeWithVersionList(const std::string& keySystem, uint32_t version, uint64_t movieId, const uint8_t* assetidData, uint32_t assetidSize, const uint8_t* versionlist, uint32_t versionListSize, const uint8_t* streamerChallengeData, uint32_t streamerChallengeSize, uint64_t cryptorId, uint8_t* licenseChallenge, uint32_t licenseChallengeMaxSize, uint8_t* licenseChallengeSize, uint8_t licenseSizeLen, uint8_t* session, uint8_t sessionLen) const override
             {
                     Exchange::OCDM_RESULT result = Exchange::OCDM_S_FALSE;
 
@@ -1027,7 +1027,8 @@ namespace Plugin {
                 uint32_t certificatesize,
                 const uint8_t* versionlist,
                 uint32_t versionListSize,
-                uint8_t *movieIdOut) const override
+                uint8_t *movieIdOut,
+                uint8_t movieIdSize) const override
                 {
                     Exchange::OCDM_RESULT result = Exchange::OCDM_S_FALSE;
 
@@ -1072,7 +1073,7 @@ namespace Plugin {
                     return result;
             }
 
-            Exchange::OCDM_RESULT DestroyServerExchange(const std::string& keySystem, uint32_t version, uint8_t* session) const override
+            Exchange::OCDM_RESULT DestroyServerExchange(const std::string& keySystem, uint32_t version, uint8_t* session, uint8_t sessionSize) const override
             {
                 Exchange::OCDM_RESULT result = Exchange::OCDM_S_FALSE;
                 CDMi::IMediaKeys* system = _parent.KeySystem(keySystem);
@@ -1088,7 +1089,7 @@ namespace Plugin {
                 return result;
             }
 
-           Exchange::OCDM_RESULT ProcessLicense(const std::string& keySystem, uint32_t version, uint8_t *session, const uint8_t *licenseData, uint32_t licenseDataSize, uint8_t *cryptoId) const override
+           Exchange::OCDM_RESULT ProcessLicense(const std::string& keySystem, uint32_t version, uint8_t *session, uint8_t sessionSize, const uint8_t *licenseData, uint32_t licenseDataSize, uint8_t *cryptoId, uint8_t cryptoIdSize) const override
            {
                     Exchange::OCDM_RESULT result = Exchange::OCDM_S_FALSE;
                     CDMi::IMediaKeys* system = _parent.KeySystem(keySystem);
