-        // locale-wise comparison
-        template<typename charT>
-        struct loc_equal {
-            explicit loc_equal( const std::locale& loc ) : loc_(loc) {}
-            bool operator()(charT ch1, charT ch2) {
-                return std::toupper(ch1, loc_) == std::toupper(ch2, loc_);
-            }
-        private:
-            const std::locale& loc_;
-        };
